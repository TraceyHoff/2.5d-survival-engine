{
 "$schema": "./screen.schema.json",
 "schema": "ui-screen/1",
 "id": "death",
 "title": "Death / respawn",
 "layer": "modal",
 "modal": true,
 "root": {
  "type": "box",
  "id": "death",
  "w": "fill",
  "h": "fill",
  "children": [
   {
    "type": "scrim",
    "alpha": 0.7,
    "color": "choc-800",
    "vignette": true
   },
   {
    "type": "ghost",
    "anchor": "tc",
    "x": 0,
    "y": 50,
    "w": 150,
    "h": 130
   },
   {
    "type": "text",
    "text": "Oh no... you poofed!",
    "font": "hero",
    "anchor": "tc",
    "x": 0,
    "y": 190,
    "w": 900,
    "h": 70,
    "align": "center"
   },
   {
    "type": "text",
    "text": "{death.causeText}",
    "font": "title",
    "anchor": "tc",
    "x": 0,
    "y": 262,
    "w": 900,
    "h": 40,
    "align": "center",
    "color": "parchment-300"
   },
   {
    "type": "panel",
    "frame": "panel_parchment",
    "anchor": "cc",
    "x": 0,
    "y": 70,
    "w": 520,
    "h": 120,
    "pad": 16,
    "layout": "row",
    "gap": 8,
    "justify": "between",
    "children": [
     {
      "type": "repeat",
      "each": "{death.stats}",
      "as": "s",
      "layout": "row",
      "gap": 8,
      "w": "fill",
      "h": "fill",
      "justify": "between",
      "template": {
       "type": "stat",
       "icon": "{s.icon}",
       "value": "{s.value}",
       "label": "{s.label}",
       "w": 110,
       "h": 88
      }
     }
    ]
   },
   {
    "type": "box",
    "anchor": "bc",
    "x": 0,
    "y": 110,
    "w": 700,
    "h": 56,
    "layout": "row",
    "gap": 14,
    "justify": "center",
    "children": [
     {
      "type": "button",
      "label": "Respawn at camp",
      "variant": "primary",
      "w": 240,
      "h": 56,
      "icon": "ic_campfire",
      "action": {
       "event": "player.respawn",
       "args": {
        "at": "bed"
       }
      },
      "disabled": "{!death.canRespawnAtCamp}"
     },
     {
      "type": "button",
      "label": "Somewhere new",
      "variant": "gold",
      "w": 220,
      "h": 56,
      "icon": "ic_map",
      "action": {
       "event": "player.respawn",
       "args": {
        "at": "random"
       }
      }
     },
     {
      "type": "button",
      "label": "Watch friends",
      "variant": "secondary",
      "w": 200,
      "h": 56,
      "icon": "ic_players",
      "action": {
       "event": "player.spectate"
      }
     }
    ]
   },
   {
    "type": "box",
    "anchor": "bc",
    "x": 0,
    "y": 64,
    "w": 420,
    "h": 36,
    "layout": "row",
    "gap": 8,
    "align": "center",
    "children": [
     {
      "type": "text",
      "text": "Respawn ready in",
      "font": "hudSmall",
      "w": 130
     },
     {
      "type": "bar",
      "vital": "stamina",
      "value": "{death.cooldownLeft}",
      "max": "{death.cooldown}",
      "w": "fill",
      "h": 18,
      "invert": true
     },
     {
      "type": "text",
      "text": "{death.cooldownLeft|int}s",
      "font": "hud",
      "w": 40,
      "align": "right"
     }
    ]
   }
  ]
 },
 "trigger": "gameplay.Died (owned entity)"
}