{
  "$schema": "../screen.schema.json",
  "schema": "ui-screen/1",
  "id": "inventory",
  "setsState": {
    "ui.windowOpen": true
  },
  "title": "Inventory + equipment",
  "layer": "window",
  "modal": false,
  "pauses": false,
  "openWith": [
    "Tab",
    "KeyI"
  ],
  "root": {
    "type": "box",
    "w": "fill",
    "h": "fill",
    "children": [
      {
        "type": "scrim",
        "alpha": 0.35
      },
      {
        "type": "box",
        "id": "inventory_window",
        "anchor": "cc",
        "x": 0,
        "y": 0,
        "w": 820,
        "h": 400,
        "children": [
          {
            "type": "include",
            "src": "_partials/journal_tabs.json",
            "params": {
              "active": "inventory"
            },
            "anchor": "tl",
            "x": 28,
            "y": -40
          },
          {
            "type": "panel",
            "id": "inventory_frame",
            "frame": "panel_wood_vine",
            "anchor": "tl",
            "x": 0,
            "y": 0,
            "w": 820,
            "h": 400,
            "pad": 24,
            "children": [
              {
                "type": "panel",
                "id": "paperdoll",
                "frame": "panel_inset",
                "anchor": "tl",
                "x": 0,
                "y": 0,
                "w": 272,
                "h": 352,
                "pad": 10,
                "children": [
                  {
                    "type": "portrait",
                    "bind": "{player.appearance}",
                    "anchor": "tl",
                    "x": 64,
                    "y": 8,
                    "w": 96,
                    "h": 176
                  },
                  {
                    "type": "slot",
                    "id": "eq_head",
                    "anchor": "tl",
                    "x": 6,
                    "y": 4,
                    "w": 52,
                    "h": 52,
                    "bind": "{equipment.head}",
                    "placeholderIcon": "eq_head",
                    "tooltip": "Head",
                    "accepts": "equip:head",
                    "action": {
                      "event": "equipment.slotClick",
                      "args": {
                        "slot": "head"
                      }
                    }
                  },
                  {
                    "type": "slot",
                    "id": "eq_back",
                    "anchor": "tl",
                    "x": 214,
                    "y": 4,
                    "w": 52,
                    "h": 52,
                    "bind": "{equipment.back}",
                    "placeholderIcon": "eq_back",
                    "tooltip": "Back",
                    "accepts": "equip:back",
                    "action": {
                      "event": "equipment.slotClick",
                      "args": {
                        "slot": "back"
                      }
                    }
                  },
                  {
                    "type": "slot",
                    "id": "eq_chest",
                    "anchor": "tl",
                    "x": 6,
                    "y": 64,
                    "w": 52,
                    "h": 52,
                    "bind": "{equipment.chest}",
                    "placeholderIcon": "eq_chest",
                    "tooltip": "Chest",
                    "accepts": "equip:chest",
                    "action": {
                      "event": "equipment.slotClick",
                      "args": {
                        "slot": "chest"
                      }
                    }
                  },
                  {
                    "type": "slot",
                    "id": "eq_mainhand",
                    "anchor": "tl",
                    "x": 214,
                    "y": 64,
                    "w": 52,
                    "h": 52,
                    "bind": "{equipment.mainhand}",
                    "placeholderIcon": "eq_mainhand",
                    "tooltip": "Mainhand",
                    "accepts": "equip:mainhand",
                    "action": {
                      "event": "equipment.slotClick",
                      "args": {
                        "slot": "mainhand"
                      }
                    }
                  },
                  {
                    "type": "slot",
                    "id": "eq_legs",
                    "anchor": "tl",
                    "x": 6,
                    "y": 124,
                    "w": 52,
                    "h": 52,
                    "bind": "{equipment.legs}",
                    "placeholderIcon": "eq_legs",
                    "tooltip": "Legs",
                    "accepts": "equip:legs",
                    "action": {
                      "event": "equipment.slotClick",
                      "args": {
                        "slot": "legs"
                      }
                    }
                  },
                  {
                    "type": "slot",
                    "id": "eq_offhand",
                    "anchor": "tl",
                    "x": 214,
                    "y": 124,
                    "w": 52,
                    "h": 52,
                    "bind": "{equipment.offhand}",
                    "placeholderIcon": "eq_offhand",
                    "tooltip": "Offhand",
                    "accepts": "equip:offhand",
                    "action": {
                      "event": "equipment.slotClick",
                      "args": {
                        "slot": "offhand"
                      }
                    }
                  },
                  {
                    "type": "slot",
                    "id": "eq_feet",
                    "anchor": "tl",
                    "x": 6,
                    "y": 184,
                    "w": 52,
                    "h": 52,
                    "bind": "{equipment.feet}",
                    "placeholderIcon": "eq_feet",
                    "tooltip": "Feet",
                    "accepts": "equip:feet",
                    "action": {
                      "event": "equipment.slotClick",
                      "args": {
                        "slot": "feet"
                      }
                    }
                  },
                  {
                    "type": "slot",
                    "id": "eq_hands",
                    "anchor": "tl",
                    "x": 214,
                    "y": 184,
                    "w": 52,
                    "h": 52,
                    "bind": "{equipment.hands}",
                    "placeholderIcon": "eq_hands",
                    "tooltip": "Hands",
                    "accepts": "equip:hands",
                    "action": {
                      "event": "equipment.slotClick",
                      "args": {
                        "slot": "hands"
                      }
                    }
                  },
                  {
                    "type": "slot",
                    "id": "eq_trinket",
                    "anchor": "tl",
                    "x": 110,
                    "y": 184,
                    "w": 52,
                    "h": 52,
                    "bind": "{equipment.trinket}",
                    "placeholderIcon": "eq_trinket",
                    "tooltip": "Trinket",
                    "accepts": "equip:trinket",
                    "action": {
                      "event": "equipment.slotClick",
                      "args": {
                        "slot": "trinket"
                      }
                    }
                  },
                  {
                    "type": "box",
                    "anchor": "bl",
                    "x": 0,
                    "y": 0,
                    "w": "fill",
                    "h": 24,
                    "layout": "row",
                    "gap": 6,
                    "align": "center",
                    "children": [
                      {
                        "type": "icon",
                        "icon": "st_cold",
                        "w": 24,
                        "h": 24
                      },
                      {
                        "type": "text",
                        "text": "Warmth +{player.stats.insulation|int}\u00b0",
                        "font": "small",
                        "w": "fill"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "box",
                "anchor": "tl",
                "x": 296,
                "y": 0,
                "w": 476,
                "h": 300,
                "children": [
                  {
                    "type": "box",
                    "layout": "row",
                    "h": 28,
                    "w": "fill",
                    "gap": 8,
                    "align": "center",
                    "children": [
                      {
                        "type": "text",
                        "text": "Pockets",
                        "font": "heading",
                        "w": "fill"
                      },
                      {
                        "type": "button",
                        "variant": "secondary",
                        "icon": "ic_star",
                        "w": 36,
                        "h": 32,
                        "tooltip": "Sort",
                        "action": {
                          "event": "inventory.sort"
                        }
                      },
                      {
                        "type": "button",
                        "variant": "danger",
                        "icon": "ic_trash",
                        "w": 36,
                        "h": 32,
                        "tooltip": "Drop selected",
                        "action": {
                          "event": "inventory.drop",
                          "args": {
                            "index": "{inventory.selected}"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "repeat",
                    "id": "inv_grid",
                    "each": "{inventory.slots}",
                    "as": "slot",
                    "layout": "grid",
                    "cols": 8,
                    "cell": [
                      52,
                      52
                    ],
                    "gap": 6,
                    "y": 38,
                    "w": "fill",
                    "h": 110,
                    "template": {
                      "type": "include",
                      "src": "_partials/item_slot.json",
                      "params": {
                        "slot": "{slot}",
                        "size": 52,
                        "hotkey": "{slot.hotkey}"
                      }
                    }
                  },
                  {
                    "type": "panel",
                    "frame": "panel_parchment",
                    "anchor": "tl",
                    "x": 0,
                    "y": 162,
                    "w": "fill",
                    "h": 100,
                    "pad": [
                      12,
                      16,
                      12,
                      16
                    ],
                    "layout": "col",
                    "gap": 6,
                    "children": [
                      {
                        "type": "box",
                        "layout": "row",
                        "gap": 8,
                        "h": 24,
                        "w": "fill",
                        "align": "center",
                        "children": [
                          {
                            "type": "icon",
                            "icon": "ic_info",
                            "w": 20,
                            "h": 20
                          },
                          {
                            "type": "text",
                            "text": "Row 1 is your hotbar (keys 1-8).",
                            "font": "small",
                            "w": "fill"
                          }
                        ]
                      },
                      {
                        "type": "box",
                        "layout": "row",
                        "gap": 8,
                        "h": 28,
                        "w": "fill",
                        "align": "center",
                        "children": [
                          {
                            "type": "keyhint",
                            "key": "LMB",
                            "label": "Move"
                          },
                          {
                            "type": "keyhint",
                            "key": "RMB",
                            "label": "Use / eat"
                          },
                          {
                            "type": "keyhint",
                            "key": "Shift",
                            "label": "Split"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "box",
                    "anchor": "bl",
                    "x": 0,
                    "y": 0,
                    "w": "fill",
                    "h": 24,
                    "layout": "row",
                    "gap": 6,
                    "align": "center",
                    "children": [
                      {
                        "type": "icon",
                        "icon": "ic_weight",
                        "w": 20,
                        "h": 20
                      },
                      {
                        "type": "text",
                        "text": "Carry weight",
                        "font": "label",
                        "w": "fill"
                      },
                      {
                        "type": "text",
                        "text": "{inventory.weight|fixed1} / {inventory.maxWeight|int} kg",
                        "font": "label",
                        "w": 120,
                        "align": "right"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "bar",
                "id": "weight_bar",
                "vital": "stamina",
                "value": "{inventory.weight}",
                "max": "{inventory.maxWeight}",
                "anchor": "bl",
                "x": 296,
                "y": 10,
                "w": 476,
                "h": 20
              },
              {
                "type": "include",
                "src": "_partials/item_tooltip.json",
                "params": {
                  "item": "{hover.item}"
                },
                "worldAnchor": "{hover.screenPos}",
                "anchor": "tl",
                "x": 560,
                "y": 110,
                "visible": "{hover.item}"
              }
            ]
          },
          {
            "type": "button",
            "id": "close",
            "variant": "close",
            "anchor": "tr",
            "x": 10,
            "y": -10,
            "w": 32,
            "h": 32,
            "action": {
              "event": "ui.close",
              "args": {
                "screen": "inventory"
              }
            },
            "hotkey": "Escape",
            "tooltip": "Close (Esc)"
          }
        ]
      }
    ]
  },
  "drag": {
    "source": "slot",
    "targets": [
      "slot",
      "eq_*",
      "world"
    ],
    "events": [
      "inventory.move",
      "inventory.split(shift)",
      "inventory.drop(world)"
    ]
  }
}
