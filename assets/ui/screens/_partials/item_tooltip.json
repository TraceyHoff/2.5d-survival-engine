{
 "schema": "ui-partial/1",
 "params": {
  "item": "{hover.item}"
 },
 "root": {
  "type": "tooltip",
  "id": "item_tooltip",
  "w": 260,
  "h": "auto",
  "pad": 12,
  "layout": "col",
  "gap": 6,
  "children": [
   {
    "type": "box",
    "layout": "row",
    "gap": 8,
    "h": 40,
    "align": "center",
    "children": [
     {
      "type": "slot",
      "w": 40,
      "h": 40,
      "bind": "{$item}",
      "showCount": false
     },
     {
      "type": "box",
      "layout": "col",
      "w": "fill",
      "h": 40,
      "children": [
       {
        "type": "text",
        "text": "{$item.name}",
        "font": "heading",
        "h": 22
       },
       {
        "type": "text",
        "text": "{$item.rarityLabel} \u00b7 {$item.categoryLabel}",
        "font": "small",
        "color": "{\"rarity.\" + $item.rarity}",
        "h": 16
       }
      ]
     }
    ]
   },
   {
    "type": "divider",
    "w": "fill",
    "h": 14
   },
   {
    "type": "text",
    "text": "{$item.description}",
    "font": "small",
    "w": "fill",
    "wrap": true,
    "h": "auto"
   },
   {
    "type": "box",
    "layout": "row",
    "gap": 6,
    "h": 20,
    "w": "fill",
    "align": "center",
    "visible": "{$item.food}",
    "children": [
     {
      "type": "foodbadge",
      "stage": "{$item.food.stage}",
      "w": 16,
      "h": 16
     },
     {
      "type": "text",
      "text": "{$item.food.stageLabel}",
      "font": "label",
      "w": 70,
      "color": "{\"food.\" + $item.food.stage}"
     },
     {
      "type": "bar",
      "vital": "hunger",
      "value": "{1 - $item.food.spoiled}",
      "max": 1,
      "w": "fill",
      "h": 12,
      "thin": true
     }
    ]
   },
   {
    "type": "repeat",
    "each": "{$item.stats}",
    "as": "stat",
    "layout": "col",
    "gap": 2,
    "w": "fill",
    "h": "auto",
    "template": {
     "type": "box",
     "layout": "row",
     "gap": 6,
     "h": 20,
     "w": "fill",
     "children": [
      {
       "type": "icon",
       "icon": "{stat.icon}",
       "w": 20,
       "h": 20
      },
      {
       "type": "text",
       "text": "{stat.label}",
       "font": "small",
       "w": "fill"
      },
      {
       "type": "text",
       "text": "{stat.value}",
       "font": "label",
       "color": "{stat.color}"
      }
     ]
    }
   },
   {
    "type": "box",
    "layout": "row",
    "h": 18,
    "w": "fill",
    "children": [
     {
      "type": "icon",
      "icon": "ic_weight",
      "w": 16,
      "h": 16
     },
     {
      "type": "text",
      "text": "{$item.weight|fixed1} kg",
      "font": "tiny",
      "w": "fill"
     },
     {
      "type": "text",
      "text": "{$item.count}/{$item.maxStack}",
      "font": "tiny"
     }
    ]
   }
  ]
 }
}