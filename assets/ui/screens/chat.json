{
 "$schema": "./screen.schema.json",
 "schema": "ui-screen/1",
 "contextMenu": {
  "whisper": {
   "event": "chat.whisper",
   "args": {
    "to": "$player"
   }
  },
  "mute": {
   "event": "social.mute",
   "args": {
    "player": "$player"
   }
  },
  "block": {
   "event": "social.block",
   "args": {
    "player": "$player"
   }
  },
  "report": {
   "opens": "reportPicker",
   "reasons": "theme.report.reasons (1 Spam, 2 Abuse, 3 Cheating, 4 Other)"
  }
 },
 "reportCommand": {
  "event": "net.reportPlayer",
  "args": {
   "targetPlayerId": "$player",
   "reason": "$reason",
   "messageTick": "$messageTick"
  },
  "maps": "client.reportPlayer(targetPlayerId, reason, messageTick?)"
 },
 "id": "chat",
 "setsState": {
  "ui.windowOpen": true
 },
 "title": "Chat + player list",
 "layer": "window",
 "modal": false,
 "openWith": [
  "Enter",
  "KeyP"
 ],
 "variants": {
  "compact": {
   "type": "box",
   "id": "chat_compact",
   "w": 400,
   "h": 150,
   "layout": "col",
   "gap": 6,
   "children": [
    {
     "type": "panel",
     "frame": "panel_hud",
     "w": "fill",
     "h": "fill",
     "pad": [
      8,
      12,
      8,
      12
     ],
     "opacity": 0.85,
     "children": [
      {
       "type": "repeat",
       "each": "{chat.recent}",
       "as": "m",
       "layout": "col",
       "gap": 4,
       "w": "fill",
       "h": "fill",
       "justify": "end",
       "template": {
        "type": "chatline",
        "channel": "{m.channel}",
        "channelId": "{m.channelId}",
        "from": "{m._vm.fromName}",
        "fromPlayer": "{m.fromPlayer}",
        "text": "{m.text}",
        "emote": "{m.emote}",
        "mentions": "{m.mentions}",
        "kind": "{m._vm.kind}",
        "highlight": "{m._vm.mentionsMe}",
        "w": "fill",
        "h": 20,
        "fadeAfterTicks": 200,
        "tick": "{m.tick}"
       }
      }
     ]
    },
    {
     "type": "box",
     "layout": "row",
     "gap": 6,
     "h": 28,
     "align": "center",
     "children": [
      {
       "type": "keyhint",
       "key": "Enter",
       "label": "Chat"
      },
      {
       "type": "keyhint",
       "key": "P",
       "label": "Players"
      }
     ]
    }
   ]
  }
 },
 "root": {
  "type": "box",
  "w": "fill",
  "h": "fill",
  "children": [
   {
    "type": "scrim",
    "alpha": 0.25
   },
   {
    "type": "box",
    "id": "chat_window",
    "anchor": "cc",
    "x": -190,
    "y": 0,
    "w": 560,
    "h": 460,
    "children": [
     {
      "type": "panel",
      "id": "chat_frame",
      "frame": "panel_wood_vine",
      "anchor": "tl",
      "x": 0,
      "y": 0,
      "w": 560,
      "h": 460,
      "pad": 24,
      "children": [
       {
        "type": "panel",
        "frame": "panel_inset",
        "anchor": "tl",
        "x": 0,
        "y": 0,
        "w": 512,
        "h": 340,
        "pad": 10,
        "children": [
         {
          "type": "list",
          "id": "chat_log",
          "w": "fill",
          "h": "fill",
          "scroll": "{chat.scroll}",
          "stickToBottom": true,
          "children": [
           {
            "type": "repeat",
            "each": "{chat.history}",
            "as": "m",
            "layout": "col",
            "gap": 6,
            "w": "fill",
            "h": "auto",
            "template": {
             "type": "chatline",
             "channel": "{m.channel}",
             "channelId": "{m.channelId}",
             "from": "{m._vm.fromName}",
             "fromPlayer": "{m.fromPlayer}",
             "text": "{m.text}",
             "emote": "{m.emote}",
             "mentions": "{m.mentions}",
             "kind": "{m._vm.kind}",
             "highlight": "{m._vm.mentionsMe}",
             "time": "{m.tick|tickclock}",
             "w": "fill",
             "h": 22,
             "dark": false,
             "contextMenu": {
              "player": "{m.fromPlayer}",
              "messageTick": "{m.tick}",
              "items": [
               "whisper",
               "mute",
               "block",
               "report"
              ]
             }
            }
           }
          ]
         }
        ]
       },
       {
        "type": "box",
        "anchor": "bl",
        "x": 0,
        "y": 0,
        "w": 512,
        "h": 48,
        "layout": "row",
        "gap": 8,
        "align": "center",
        "children": [
         {
          "type": "button",
          "id": "chat_channel",
          "variant": "secondary",
          "label": "{chat.channel|channel|upper}",
          "w": 96,
          "h": 44,
          "tooltip": "Channel (Tab to cycle): global, local, party, clan, trade, /w name",
          "action": {
           "event": "chat.cycleChannel"
          }
         },
         {
          "type": "input",
          "id": "chat_input",
          "w": "fill",
          "h": 44,
          "bind": "{chat.draft}",
          "placeholder": "Say something nice...",
          "maxLength": 200,
          "focus": true,
          "action": {
           "event": "chat.send",
           "args": {
            "channel": "{chat.channel}",
            "text": "{chat.draft}",
            "to": "$whisperTarget",
            "mentions": "$resolvedMentions",
            "emote": "$emote"
           },
           "maps": "client.chat.send(channel, text, {to?, mentions?, emote?})"
          }
         },
         {
          "type": "button",
          "label": "Send",
          "variant": "primary",
          "w": 96,
          "h": 44,
          "action": {
           "event": "chat.send",
           "args": {
            "text": "{chat.draft}"
           }
          }
         }
        ]
       }
      ]
     },
     {
      "type": "ribbon",
      "text": "Camp Chat",
      "anchor": "tc",
      "x": 0,
      "y": -18,
      "w": 294,
      "h": 40
     },
     {
      "type": "button",
      "id": "close",
      "variant": "close",
      "anchor": "tr",
      "x": 10,
      "y": -10,
      "w": 32,
      "h": 32,
      "action": {
       "event": "ui.close",
       "args": {
        "screen": "chat"
       }
      },
      "hotkey": "Escape",
      "tooltip": "Close (Esc)"
     }
    ]
   },
   {
    "type": "box",
    "id": "players_window",
    "anchor": "cc",
    "x": 290,
    "y": 0,
    "w": 340,
    "h": 460,
    "children": [
     {
      "type": "panel",
      "id": "players_frame",
      "frame": "panel_wood",
      "anchor": "tl",
      "x": 0,
      "y": 0,
      "w": 340,
      "h": 460,
      "pad": 24,
      "children": [
       {
        "type": "tabs",
        "w": "fill",
        "h": 40,
        "bind": "{social.tab}",
        "small": true,
        "items": [
         {
          "id": "party",
          "label": "Party",
          "action": {
           "event": "social.tab",
           "args": {
            "tab": "party"
           }
          }
         },
         {
          "id": "clan",
          "label": "Clan",
          "action": {
           "event": "social.tab",
           "args": {
            "tab": "clan"
           }
          }
         },
         {
          "id": "server",
          "label": "Here",
          "action": {
           "event": "social.tab",
           "args": {
            "tab": "server"
           }
          }
         }
        ]
       },
       {
        "type": "panel",
        "frame": "panel_parchment",
        "anchor": "tl",
        "x": 0,
        "y": 40,
        "w": "fill",
        "h": 372,
        "pad": 10,
        "layout": "col",
        "gap": 6,
        "children": [
         {
          "type": "box",
          "layout": "row",
          "h": 24,
          "w": "fill",
          "gap": 6,
          "align": "center",
          "visible": "{social.tab == \"party\"}",
          "children": [
           {
            "type": "text",
            "text": "Party {groups._vm.party.members.length}/{groups._vm.party.max}",
            "font": "label",
            "w": "fill"
           },
           {
            "type": "button",
            "variant": "primary",
            "icon": "ic_plus",
            "w": 32,
            "h": 28,
            "tooltip": "Invite",
            "action": {
             "event": "party.invite"
            }
           },
           {
            "type": "button",
            "variant": "danger",
            "icon": "ic_cross",
            "w": 32,
            "h": 28,
            "tooltip": "Leave party",
            "action": {
             "event": "party.leave"
            }
           }
          ]
         },
         {
          "type": "box",
          "layout": "row",
          "h": 24,
          "w": "fill",
          "gap": 6,
          "align": "center",
          "visible": "{social.tab == \"clan\"}",
          "children": [
           {
            "type": "banner",
            "bind": "{groups._vm.clan.banner}",
            "w": 24,
            "h": 24
           },
           {
            "type": "text",
            "text": "[{groups._vm.clan.tag}] {groups._vm.clan.name} {groups._vm.clan.members.length}/{groups._vm.clan.max}",
            "font": "label",
            "w": "fill"
           }
          ]
         },
         {
          "type": "list",
          "w": "fill",
          "h": "fill",
          "children": [
           {
            "type": "box",
            "layout": "col",
            "w": "fill",
            "h": "auto",
            "visible": "{social.tab == \"party\"}",
            "children": [
             {
              "type": "repeat",
              "each": "{groups._vm.party.members}",
              "as": "p",
              "layout": "col",
              "gap": 6,
              "w": "fill",
              "h": "auto",
              "template": {
               "type": "panel",
               "frame": "panel_inset",
               "w": "fill",
               "h": 56,
               "pad": [
                6,
                8,
                6,
                8
               ],
               "layout": "row",
               "gap": 8,
               "align": "center",
               "opacity": "{p._vm.online ? 1 : 0.6}",
               "children": [
                {
                 "type": "avatar",
                 "color": "{p.playerId}",
                 "online": "{p._vm.online}",
                 "w": 36,
                 "h": 36
                },
                {
                 "type": "box",
                 "layout": "col",
                 "w": "fill",
                 "h": 44,
                 "gap": 2,
                 "children": [
                  {
                   "type": "box",
                   "layout": "row",
                   "gap": 6,
                   "h": 20,
                   "w": "fill",
                   "align": "center",
                   "children": [
                    {
                     "type": "text",
                     "text": "{p._vm.name}",
                     "font": "label",
                     "w": 76
                    },
                    {
                     "type": "rank",
                     "role": "{p.role}",
                     "w": 54,
                     "h": 18
                    }
                   ]
                  },
                  {
                   "type": "bar",
                   "vital": "health",
                   "value": "{p._vm.hpPct}",
                   "max": 1,
                   "w": "fill",
                   "h": 14,
                   "thin": true,
                   "visible": "{p._vm.online && p._vm.hpPct != null}"
                  },
                  {
                   "type": "text",
                   "text": "{p._vm.inView ? \"\" : \"far away\"}",
                   "font": "tiny",
                   "h": 14,
                   "visible": "{p._vm.online && p._vm.hpPct == null}"
                  },
                  {
                   "type": "text",
                   "text": "offline",
                   "font": "tiny",
                   "h": 14,
                   "visible": "{!p._vm.online}"
                  }
                 ]
                },
                {
                 "type": "button",
                 "variant": "secondary",
                 "icon": "ic_chat",
                 "w": 32,
                 "h": 32,
                 "tooltip": "Whisper / mute / block / report...",
                 "action": {
                  "event": "ui.contextMenu",
                  "args": {
                   "player": "{p.playerId}",
                   "items": [
                    "whisper",
                    "mute",
                    "block",
                    "report",
                    "party.kick",
                    "clan.promote"
                   ]
                  }
                 },
                 "visible": "{p.playerId != me.playerId}"
                }
               ]
              }
             }
            ]
           },
           {
            "type": "box",
            "layout": "col",
            "w": "fill",
            "h": "auto",
            "visible": "{social.tab == \"clan\"}",
            "children": [
             {
              "type": "repeat",
              "each": "{groups._vm.clan.members}",
              "as": "p",
              "layout": "col",
              "gap": 6,
              "w": "fill",
              "h": "auto",
              "template": {
               "type": "panel",
               "frame": "panel_inset",
               "w": "fill",
               "h": 56,
               "pad": [
                6,
                8,
                6,
                8
               ],
               "layout": "row",
               "gap": 8,
               "align": "center",
               "opacity": "{p._vm.online ? 1 : 0.6}",
               "children": [
                {
                 "type": "avatar",
                 "color": "{p.playerId}",
                 "online": "{p._vm.online}",
                 "w": 36,
                 "h": 36
                },
                {
                 "type": "box",
                 "layout": "col",
                 "w": "fill",
                 "h": 44,
                 "gap": 2,
                 "children": [
                  {
                   "type": "box",
                   "layout": "row",
                   "gap": 6,
                   "h": 20,
                   "w": "fill",
                   "align": "center",
                   "children": [
                    {
                     "type": "text",
                     "text": "{p._vm.name}",
                     "font": "label",
                     "w": 76
                    },
                    {
                     "type": "rank",
                     "role": "{p.role}",
                     "w": 54,
                     "h": 18
                    }
                   ]
                  },
                  {
                   "type": "bar",
                   "vital": "health",
                   "value": "{p._vm.hpPct}",
                   "max": 1,
                   "w": "fill",
                   "h": 14,
                   "thin": true,
                   "visible": "{p._vm.online && p._vm.hpPct != null}"
                  },
                  {
                   "type": "text",
                   "text": "{p._vm.inView ? \"\" : \"far away\"}",
                   "font": "tiny",
                   "h": 14,
                   "visible": "{p._vm.online && p._vm.hpPct == null}"
                  },
                  {
                   "type": "text",
                   "text": "offline",
                   "font": "tiny",
                   "h": 14,
                   "visible": "{!p._vm.online}"
                  }
                 ]
                },
                {
                 "type": "button",
                 "variant": "secondary",
                 "icon": "ic_chat",
                 "w": 32,
                 "h": 32,
                 "tooltip": "Whisper / mute / block / report...",
                 "action": {
                  "event": "ui.contextMenu",
                  "args": {
                   "player": "{p.playerId}",
                   "items": [
                    "whisper",
                    "mute",
                    "block",
                    "report",
                    "party.kick",
                    "clan.promote"
                   ]
                  }
                 },
                 "visible": "{p.playerId != me.playerId}"
                }
               ]
              }
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     },
     {
      "type": "ribbon",
      "text": "Campers",
      "anchor": "tc",
      "x": 0,
      "y": -18,
      "w": 242,
      "h": 40
     }
    ]
   }
  ]
 }
}