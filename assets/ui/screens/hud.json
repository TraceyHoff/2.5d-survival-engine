{
  "$schema": "../screen.schema.json",
  "schema": "ui-screen/1",
  "id": "hud",
  "title": "HUD",
  "layer": "hud",
  "modal": false,
  "design": [
    1280,
    720
  ],
  "root": {
    "type": "box",
    "id": "hud",
    "w": "fill",
    "h": "fill",
    "children": [
      {
        "type": "panel",
        "id": "vitals",
        "visible": "{!ui.windowOpen}",
        "frame": "panel_hud",
        "anchor": "tl",
        "x": 14,
        "y": 14,
        "w": 290,
        "h": "auto",
        "pad": [
          10,
          12,
          10,
          10
        ],
        "layout": "col",
        "gap": 2,
        "children": [
          {
            "type": "box",
            "layout": "row",
            "h": 24,
            "w": "fill",
            "gap": 6,
            "align": "center",
            "children": [
              {
                "type": "text",
                "text": "{player.name}",
                "font": "hud",
                "w": "fill"
              },
              {
                "type": "badge",
                "text": "Lv {player.xp.level}",
                "color": "plum-500",
                "h": 20,
                "w": 52
              }
            ]
          },
          {
            "type": "box",
            "layout": "row",
            "gap": 6,
            "h": 30,
            "w": "fill",
            "align": "center",
            "children": [
              {
                "type": "icon",
                "icon": "vital_health",
                "w": 32,
                "h": 32,
                "iconLow": "vital_health_low",
                "lowWhen": "{player.vitals.health / player.vitals.healthMax < 0.25}",
                "pulseWhenLow": true
              },
              {
                "type": "bar",
                "vital": "health",
                "value": "{player.vitals.health}",
                "max": "{player.vitals.healthMax}",
                "w": "fill",
                "h": 20,
                "delta": true,
                "tooltip": "Health"
              },
              {
                "type": "text",
                "text": "{player.vitals.health|int}",
                "font": "hudSmall",
                "w": 30,
                "h": 20,
                "align": "right"
              }
            ]
          },
          {
            "type": "box",
            "layout": "row",
            "gap": 6,
            "h": 30,
            "w": "fill",
            "align": "center",
            "children": [
              {
                "type": "icon",
                "icon": "vital_hunger",
                "w": 32,
                "h": 32,
                "iconLow": "vital_hunger_low",
                "lowWhen": "{player.vitals.hunger / 100 < 0.2}",
                "pulseWhenLow": true
              },
              {
                "type": "bar",
                "vital": "hunger",
                "value": "{player.vitals.hunger}",
                "max": "{100}",
                "w": "fill",
                "h": 20,
                "delta": true,
                "tooltip": "Hunger"
              },
              {
                "type": "text",
                "text": "{player.vitals.hunger|int}",
                "font": "hudSmall",
                "w": 30,
                "h": 20,
                "align": "right"
              }
            ]
          },
          {
            "type": "box",
            "layout": "row",
            "gap": 6,
            "h": 30,
            "w": "fill",
            "align": "center",
            "children": [
              {
                "type": "icon",
                "icon": "vital_thirst",
                "w": 32,
                "h": 32,
                "iconLow": "vital_thirst_low",
                "lowWhen": "{player.vitals.thirst / 100 < 0.2}",
                "pulseWhenLow": true
              },
              {
                "type": "bar",
                "vital": "thirst",
                "value": "{player.vitals.thirst}",
                "max": "{100}",
                "w": "fill",
                "h": 20,
                "delta": true,
                "tooltip": "Thirst"
              },
              {
                "type": "text",
                "text": "{player.vitals.thirst|int}",
                "font": "hudSmall",
                "w": 30,
                "h": 20,
                "align": "right"
              }
            ]
          },
          {
            "type": "box",
            "layout": "row",
            "gap": 6,
            "h": 30,
            "w": "fill",
            "align": "center",
            "children": [
              {
                "type": "icon",
                "icon": "vital_stamina",
                "w": 32,
                "h": 32,
                "iconLow": "vital_stamina_low",
                "lowWhen": "{player.vitals.stamina / player.vitals.staminaMax < 0.15}",
                "pulseWhenLow": true
              },
              {
                "type": "bar",
                "vital": "stamina",
                "value": "{player.vitals.stamina}",
                "max": "{player.vitals.staminaMax}",
                "w": "fill",
                "h": 20,
                "delta": true,
                "tooltip": "Stamina"
              },
              {
                "type": "text",
                "text": "{player.vitals.stamina|int}",
                "font": "hudSmall",
                "w": 30,
                "h": 20,
                "align": "right"
              }
            ]
          },
          {
            "type": "box",
            "layout": "row",
            "gap": 6,
            "h": 30,
            "w": "fill",
            "align": "center",
            "children": [
              {
                "type": "icon",
                "icon": "vital_temp",
                "w": 32,
                "h": 32,
                "iconCold": "vital_cold",
                "iconHot": "vital_hot",
                "bindTemp": "{player.vitals.bodyTemp}"
              },
              {
                "type": "bar",
                "vital": "temperature",
                "value": "{player.vitals.bodyTemp}",
                "min": 25,
                "max": 45,
                "marker": true,
                "comfort": [
                  36,
                  38
                ],
                "w": "fill",
                "h": 20,
                "tooltip": "Body temperature"
              },
              {
                "type": "text",
                "text": "{player.vitals.bodyTemp|int}\u00b0",
                "font": "hudSmall",
                "w": 30,
                "h": 20,
                "align": "right"
              }
            ]
          }
        ]
      },
      {
        "type": "repeat",
        "id": "status_effects",
        "visible": "{!ui.windowOpen}",
        "each": "{player.effects}",
        "as": "fx",
        "anchor": "tl",
        "x": 16,
        "y": 232,
        "layout": "row",
        "gap": 6,
        "w": 290,
        "h": 44,
        "template": {
          "type": "status",
          "icon": "{fx.icon}",
          "w": 40,
          "h": 40,
          "remaining": "{fx.remaining}",
          "tone": "{fx.tone}",
          "tooltip": "{fx.label}: {fx.description}"
        }
      },
      {
        "type": "minimap",
        "id": "minimap",
        "anchor": "tr",
        "x": 14,
        "y": 12,
        "w": 176,
        "h": 176,
        "bind": "{map.minimap}",
        "markers": "{map.markers}",
        "memberPins": "{map.memberPins}",
        "heading": "{player.facing}",
        "action": {
          "event": "ui.open",
          "args": {
            "screen": "world_map"
          }
        },
        "hotkey": "M"
      },
      {
        "type": "panel",
        "id": "clock",
        "visible": "{!ui.windowOpen}",
        "frame": "panel_hud",
        "anchor": "tr",
        "x": 30,
        "y": 192,
        "w": 144,
        "h": 40,
        "pad": [
          4,
          10,
          4,
          6
        ],
        "layout": "row",
        "gap": 4,
        "align": "center",
        "children": [
          {
            "type": "icon",
            "icon": "{world.time.phaseIcon}",
            "w": 28,
            "h": 28
          },
          {
            "type": "text",
            "text": "Day {world.time.day}",
            "font": "hudSmall",
            "w": "fill"
          },
          {
            "type": "text",
            "text": "{world.time.hours|time}",
            "font": "hud",
            "w": 46,
            "align": "right"
          }
        ]
      },
      {
        "type": "panel",
        "id": "weather",
        "visible": "{!ui.windowOpen}",
        "frame": "panel_hud",
        "anchor": "tr",
        "x": 178,
        "y": 192,
        "w": 40,
        "h": 40,
        "pad": 4,
        "children": [
          {
            "type": "icon",
            "icon": "{world.weather.icon}",
            "w": 32,
            "h": 32,
            "anchor": "cc",
            "tooltip": "{world.weather.label}"
          }
        ]
      },
      {
        "type": "box",
        "id": "net_badge",
        "anchor": "tr",
        "x": 200,
        "y": 14,
        "w": 100,
        "h": 28,
        "layout": "row",
        "gap": 4,
        "align": "center",
        "justify": "end",
        "visible": "{net.connected}",
        "children": [
          {
            "type": "icon",
            "icon": "ic_players",
            "w": 24,
            "h": 24
          },
          {
            "type": "text",
            "text": "{session.players.length}",
            "font": "hudSmall",
            "w": 18
          },
          {
            "type": "icon",
            "icon": "ic_signal",
            "w": 24,
            "h": 24
          },
          {
            "type": "text",
            "text": "{net.rtt|int}ms",
            "font": "hudSmall",
            "w": 44
          }
        ]
      },
      {
        "type": "box",
        "id": "hotbar_dock",
        "visible": "{!ui.buildMode}",
        "anchor": "bc",
        "x": 0,
        "y": 12,
        "w": 472,
        "h": 100,
        "children": [
          {
            "type": "bar",
            "id": "xp",
            "vital": "xp",
            "value": "{player.xp.value}",
            "max": "{player.xp.next}",
            "anchor": "tc",
            "x": 0,
            "y": 0,
            "w": 408,
            "h": 14,
            "thin": true,
            "tooltip": "XP {player.xp.value}/{player.xp.next}"
          },
          {
            "type": "panel",
            "frame": "panel_hud",
            "anchor": "bc",
            "x": 0,
            "y": 0,
            "w": 472,
            "h": 76,
            "pad": [
              12,
              12,
              12,
              12
            ],
            "children": [
              {
                "type": "repeat",
                "each": "{hotbar.slots}",
                "as": "slot",
                "layout": "row",
                "gap": 4,
                "w": "fill",
                "h": 52,
                "template": {
                  "type": "include",
                  "src": "_partials/item_slot.json",
                  "params": {
                    "slot": "{slot}",
                    "size": 52,
                    "hotkey": "{slot.hotkey}"
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "box",
        "id": "craft_queue_mini",
        "anchor": "bc",
        "x": 330,
        "y": 24,
        "w": 150,
        "h": 56,
        "visible": "{crafting.queue.length > 0 && !ui.buildMode}",
        "layout": "col",
        "gap": 4,
        "children": [
          {
            "type": "text",
            "text": "Crafting {crafting.queue.0.name}",
            "font": "hudSmall",
            "h": 18
          },
          {
            "type": "bar",
            "vital": "xp",
            "value": "{crafting.queue.0.progress}",
            "max": "{crafting.queue.0.total}",
            "w": "fill",
            "h": 16,
            "style": "stamina"
          }
        ]
      },
      {
        "type": "box",
        "id": "interact",
        "anchor": "cc",
        "x": 40,
        "y": -70,
        "w": 170,
        "h": 36,
        "worldAnchor": "{interact.screenPos}",
        "visible": "{interact.visible && !ui.windowOpen && !ui.buildMode}",
        "layout": "row",
        "gap": 6,
        "align": "center",
        "children": [
          {
            "type": "keyhint",
            "key": "{input.bindings.interact}",
            "label": ""
          },
          {
            "type": "text",
            "text": "{interact.verb} {interact.targetName}",
            "font": "hud",
            "w": "fill"
          }
        ]
      },
      {
        "type": "bar",
        "id": "gather_progress",
        "anchor": "cc",
        "x": 40,
        "y": -36,
        "w": 120,
        "h": 16,
        "vital": "stamina",
        "value": "{interact.progress}",
        "max": 1,
        "visible": "{interact.progress > 0 && !ui.windowOpen && !ui.buildMode}"
      },
      {
        "type": "include",
        "src": "chat.json#compact",
        "visible": "{!ui.windowOpen && !ui.buildMode}",
        "anchor": "bl",
        "x": 14,
        "y": 14
      },
      {
        "type": "repeat",
        "id": "toasts",
        "visible": "{!ui.windowOpen}",
        "each": "{toasts}",
        "as": "t",
        "anchor": "cr",
        "x": 14,
        "y": -40,
        "layout": "col",
        "gap": 8,
        "w": 300,
        "h": "auto",
        "template": {
          "type": "toast",
          "kind": "{t.kind}",
          "title": "{t.title}",
          "text": "{t.text}",
          "icon": "{t.icon}",
          "w": 300,
          "h": 56,
          "ttl": "{t.ttl}"
        }
      },
      {
        "type": "box",
        "id": "keyhints",
        "visible": "{!ui.windowOpen && !ui.buildMode}",
        "anchor": "br",
        "x": 14,
        "y": 14,
        "w": 180,
        "h": 128,
        "layout": "col",
        "gap": 4,
        "children": [
          {
            "type": "keyhint",
            "key": "Tab",
            "label": "Backpack",
            "w": "fill"
          },
          {
            "type": "keyhint",
            "key": "C",
            "label": "Crafting",
            "w": "fill"
          },
          {
            "type": "keyhint",
            "key": "B",
            "label": "Build",
            "w": "fill"
          },
          {
            "type": "keyhint",
            "key": "M",
            "label": "Map",
            "w": "fill"
          }
        ]
      }
    ]
  },
  "hotkeys": {
    "Digit1..Digit8": {
      "event": "hotbar.select",
      "args": {
        "index": "$n-1"
      }
    },
    "Wheel": {
      "event": "hotbar.cycle"
    }
  }
}
