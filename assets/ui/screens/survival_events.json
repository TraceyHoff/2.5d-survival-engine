{
  "$schema": "../screen.schema.json",
  "schema": "ui-screen/1",
  "id": "survival_events",
  "title": "Survival events overlay (DeathBagDropped, Respawned, GateBreached; DESIGN \u00a711/\u00a715)",
  "layer": "hud",
  "modal": false,
  "binds": "events.* pushed by client on gameplay events. DeathBagDropped -> world vfx deathbag_drop at bag pos + toast with ui_hooks_ic_deathbag (locked variant while owner-only). Respawned -> vfx respawn_poof + respawn_puffs at player, banner_respawn 2.5s. GateBreached{piece,attacker} -> vfx gate_breach + gate_breach_splinters at piece, banner_breach (own clan) / banner_breach_win (attacker clan), minimap ping. respawn countdown shown in death.json via death.respawnIn; too_soon/not_dead rejections -> toast respawn.err.<reason>.",
  "strings": "strings/en.json",
  "inputs": {
    "kbm": [
      {
        "key": "M",
        "label": "Map ping"
      },
      {
        "key": "Space",
        "label": "Dismiss banner"
      }
    ],
    "gamepad": [
      {
        "key": "Y",
        "label": "Map ping"
      },
      {
        "key": "B",
        "label": "Dismiss"
      }
    ],
    "touch": [
      {
        "gesture": "tap banner",
        "label": "Show on map"
      },
      {
        "gesture": "swipe up banner",
        "label": "Dismiss"
      }
    ]
  },
  "root": {
    "type": "box",
    "w": "fill",
    "h": "fill",
    "children": [
      {
        "type": "banner",
        "id": "breach",
        "frame": "{events.breach.ours ? 'ui_hooks_banner_breach' : 'ui_hooks_banner_breach_win'}",
        "icon": "ui_hooks_ic_gate_breach",
        "anchor": "tc",
        "y": 96,
        "w": 460,
        "h": 64,
        "text": "{events.breach.ours ? t('event.breach.ours', events.breach.piece) : t('event.breach.theirs', events.breach.piece)}",
        "visible": "{events.breach.show}",
        "duration": 4,
        "action": {
          "event": "map.ping",
          "args": {
            "at": "{events.breach.pos}"
          }
        }
      },
      {
        "type": "banner",
        "id": "respawn",
        "frame": "ui_hooks_banner_respawn",
        "icon": "ui_hooks_ic_respawn",
        "anchor": "tc",
        "y": 96,
        "w": 380,
        "h": 56,
        "text": "{t('event.respawned')}",
        "visible": "{events.respawn.show}",
        "duration": 2.5
      },
      {
        "type": "toast",
        "id": "deathbag",
        "icon": "{events.bag.locked ? 'ui_hooks_ic_deathbag_locked' : 'ui_hooks_ic_deathbag'}",
        "anchor": "bc",
        "y": -170,
        "w": 360,
        "h": 52,
        "text": "{events.bag.locked ? t('event.bag.locked', events.bag.unlockIn) : t('event.bag.dropped')}",
        "visible": "{events.bag.show}",
        "duration": 4
      },
      {
        "type": "box",
        "id": "respawn_countdown",
        "anchor": "cc",
        "y": 150,
        "w": 220,
        "h": 72,
        "visible": "{death.respawnIn > 0}",
        "children": [
          {
            "type": "icon",
            "sprite": "ui_hooks_ic_respawn",
            "anchor": "cl",
            "w": 48,
            "h": 48
          },
          {
            "type": "text",
            "font": "title",
            "anchor": "cr",
            "w": 160,
            "h": 48,
            "text": "{t('respawn.in', death.respawnIn)}"
          }
        ]
      }
    ]
  }
}
