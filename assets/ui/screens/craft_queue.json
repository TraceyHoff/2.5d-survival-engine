{
  "$schema": "../screen.schema.json",
  "schema": "ui-screen/1",
  "id": "craft_queue",
  "title": "Queued crafting (DESIGN \u00a714, CraftQueue)",
  "layer": "hud",
  "modal": false,
  "binds": "cq.slots[4] from gameplay CraftQueue: {state: empty|queued|active|paused|done, recipe, icon, count, startTick, endTick}; cq.now = server tick. progress = clamp((now-startTick)/(endTick-startTick)); ring frame = floor(progress*23) -> ui_hooks_cq_ring_NN (paused -> cq_ring_paused_NN). Cancel sends gameplay.cancelQueuedCraft {slot}; refund = ingredients of unfinished count (tooltip). Rejections (unknown_recipe,no_actor,bad_count,no_station,queue_full,missing_ingredients,no_job) -> toast craftq.err.<reason>.",
  "strings": "strings/en.json",
  "inputs": {
    "kbm": [
      {
        "key": "C",
        "label": "Open crafting"
      },
      {
        "key": "1-4 + Del",
        "label": "Cancel slot"
      },
      {
        "key": "RMB slot",
        "label": "Cancel"
      }
    ],
    "gamepad": [
      {
        "key": "View+D-pad",
        "label": "Focus queue"
      },
      {
        "key": "X",
        "label": "Cancel focused"
      },
      {
        "key": "B",
        "label": "Back"
      }
    ],
    "touch": [
      {
        "gesture": "tap slot",
        "label": "Details"
      },
      {
        "gesture": "tap \u2715",
        "label": "Cancel (confirm)"
      },
      {
        "gesture": "long-press slot",
        "label": "Refund preview"
      }
    ]
  },
  "root": {
    "type": "box",
    "id": "craft_queue",
    "anchor": "br",
    "x": -16,
    "y": -140,
    "w": 300,
    "h": 96,
    "children": [
      {
        "type": "panel",
        "frame": "ui_hooks_cq_slot_empty",
        "w": "fill",
        "h": "fill",
        "pad": 8,
        "layout": "row",
        "gap": 8,
        "children": [
          {
            "type": "repeat",
            "each": "{cq.slots}",
            "as": "s",
            "layout": "row",
            "gap": 8,
            "w": "fill",
            "h": 72,
            "template": {
              "type": "slot",
              "w": 64,
              "h": 72,
              "minTap": 48,
              "frame": "ui_hooks_cq_slot_{s.state}",
              "focusable": true,
              "action": {
                "event": "cq.details",
                "args": {
                  "slot": "{s.index}"
                }
              },
              "children": [
                {
                  "type": "icon",
                  "sprite": "ui_hooks_cq_ring_track",
                  "anchor": "cc",
                  "w": 56,
                  "h": 56
                },
                {
                  "type": "icon",
                  "sprite": "{s.ringSprite}",
                  "anchor": "cc",
                  "w": 56,
                  "h": 56,
                  "note": "ui_hooks_cq_ring_{floor(progress*23):02d}",
                  "visible": "{s.state == 'active' || s.state == 'paused'}"
                },
                {
                  "type": "icon",
                  "sprite": "{s.icon}",
                  "anchor": "cc",
                  "w": 32,
                  "h": 32
                },
                {
                  "type": "badge",
                  "text": "x{s.count}",
                  "anchor": "br",
                  "visible": "{s.count > 1}"
                },
                {
                  "type": "button",
                  "variant": "danger",
                  "icon": "ui_hooks_cq_cancel",
                  "anchor": "tr",
                  "x": 4,
                  "y": -4,
                  "w": 24,
                  "h": 24,
                  "hit": 48,
                  "visible": "{s.state != 'empty'}",
                  "tooltip": "{t('craftq.cancel.tip', s.refundText)}",
                  "action": {
                    "event": "gameplay.cancelQueuedCraft",
                    "args": {
                      "slot": "{s.index}"
                    },
                    "confirm": "{input.touch}"
                  }
                },
                {
                  "type": "text",
                  "text": "{s.remainingText}",
                  "font": "small",
                  "anchor": "bc",
                  "y": 12,
                  "visible": "{s.state == 'active'}"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "tooltip",
        "id": "cq_refund",
        "visible": "{cq.refundPreview}",
        "children": [
          {
            "type": "icon",
            "sprite": "ui_hooks_cq_refund",
            "w": 24,
            "h": 24
          },
          {
            "type": "text",
            "text": "{cq.refundText}"
          }
        ]
      }
    ]
  }
}
