{
  "$schema": "../screen.schema.json",
  "schema": "ui-screen/1",
  "id": "stall_buy",
  "title": "Buy",
  "layer": "modal",
  "modal": true,
  "input": {
    "touch": "tap = focus+activate, long-press = inspect, swipe grid scrolls; min hit 48px",
    "gamepad": "D-pad/LS moves focus over focusOrder; A activate, X inspect, Y sort, LB/RB filter tabs, B back",
    "kbm": "click, wheel scroll, / focuses search, Enter buy, I inspect, Esc close"
  },
  "focusOrder": [
    "qty",
    "max",
    "confirm",
    "back"
  ],
  "states": {
    "ok": "buyable",
    "funds": "have < total (price item count in inventory)",
    "space": "no free slot / overweight for qty*listing.qty",
    "stock": "qty > stock (clamped)",
    "closed": "stall closed meanwhile -> toast + close"
  },
  "sends": "stall.buy {stall, slot, qty, revision}; server re-validates price/stock/revision atomically (Listings.revision)",
  "root": {
    "type": "box",
    "layout": "abs",
    "children": [
      {
        "type": "scrim",
        "alpha": 0.45
      },
      {
        "type": "panel",
        "frame": "panel_wood",
        "anchor": "cc",
        "w": 520,
        "h": 500,
        "pad": 22,
        "layout": "col",
        "gap": 8,
        "children": [
          {
            "type": "panel",
            "frame": "panel_parchment",
            "w": "fill",
            "h": "fill",
            "pad": 16,
            "layout": "col",
            "gap": 10,
            "children": [
              {
                "type": "box",
                "layout": "row",
                "children": [
                  {
                    "type": "slot",
                    "w": 72,
                    "h": 72,
                    "bind": "{buy.listing.item}",
                    "showCount": false
                  },
                  {
                    "type": "box",
                    "layout": "col",
                    "children": [
                      {
                        "type": "text",
                        "text": "{buy.listing.item.name}",
                        "font": "title",
                        "h": 34
                      },
                      {
                        "type": "include",
                        "src": "_partials/crafted_by.json",
                        "params": {
                          "item": "{buy.listing.item}"
                        }
                      },
                      {
                        "type": "box",
                        "layout": "row",
                        "children": [
                          {
                            "type": "text",
                            "text": "Each:",
                            "font": "small",
                            "w": "auto"
                          },
                          {
                            "type": "icon",
                            "icon": "{buy.listing.price.icon}",
                            "w": 20,
                            "h": 20
                          },
                          {
                            "type": "text",
                            "text": "{buy.listing.price.count} {buy.listing.price.name} for {buy.listing.qty}",
                            "font": "label",
                            "w": "auto"
                          }
                        ],
                        "gap": 4,
                        "h": 22,
                        "align": "center",
                        "w": "fill"
                      }
                    ],
                    "w": "fill",
                    "h": 80,
                    "gap": 2
                  }
                ],
                "gap": 12,
                "h": 80,
                "align": "center",
                "w": "fill"
              },
              {
                "type": "divider",
                "w": "fill",
                "h": 14
              },
              {
                "type": "box",
                "layout": "row",
                "children": [
                  {
                    "type": "text",
                    "text": "How many?",
                    "font": "heading",
                    "w": "fill"
                  },
                  {
                    "type": "stepper",
                    "bind": "{buy.qty}",
                    "w": 180,
                    "h": 44,
                    "min": 1,
                    "max": "{buy.maxQty}",
                    "id": "qty",
                    "action": {
                      "event": "stall.qty",
                      "args": {
                        "delta": "$delta"
                      }
                    }
                  },
                  {
                    "type": "button",
                    "label": "Max",
                    "variant": "secondary",
                    "w": 70,
                    "h": 44,
                    "action": {
                      "event": "stall.qty",
                      "args": {
                        "value": "{buy.maxQty}"
                      }
                    }
                  }
                ],
                "gap": 10,
                "h": 44,
                "align": "center",
                "w": "fill"
              },
              {
                "type": "text",
                "text": "{buy.listing.stock} in stock \u00b7 you get {buy.qty * buy.listing.qty}",
                "font": "small",
                "h": 18,
                "color": "text.muted"
              },
              {
                "type": "panel",
                "frame": "panel_inset",
                "w": "fill",
                "h": 88,
                "pad": 12,
                "layout": "col",
                "gap": 4,
                "children": [
                  {
                    "type": "box",
                    "layout": "row",
                    "children": [
                      {
                        "type": "text",
                        "text": "Total",
                        "font": "heading",
                        "w": "fill"
                      },
                      {
                        "type": "icon",
                        "icon": "{buy.listing.price.icon}",
                        "w": 28,
                        "h": 28
                      },
                      {
                        "type": "text",
                        "text": "{buy.total}",
                        "font": "title",
                        "w": "auto"
                      }
                    ],
                    "gap": 6,
                    "h": 34,
                    "align": "center",
                    "w": "fill"
                  },
                  {
                    "type": "box",
                    "layout": "row",
                    "children": [
                      {
                        "type": "text",
                        "text": "You have",
                        "font": "small",
                        "w": "fill"
                      },
                      {
                        "type": "text",
                        "text": "{buy.have}",
                        "font": "label",
                        "w": "auto",
                        "color": "{buy.canAfford ? \"text.success\" : \"text.danger\"}"
                      },
                      {
                        "type": "text",
                        "text": "\u2192 {buy.haveAfter}",
                        "font": "small",
                        "w": "auto",
                        "color": "text.muted",
                        "visible": "{buy.canAfford}"
                      }
                    ],
                    "gap": 6,
                    "h": 22,
                    "align": "center",
                    "w": "fill"
                  }
                ]
              },
              {
                "type": "box",
                "layout": "row",
                "children": [
                  {
                    "type": "icon",
                    "icon": "ic_warn",
                    "w": 22,
                    "h": 22
                  },
                  {
                    "type": "text",
                    "text": "{buy.message}",
                    "font": "label",
                    "w": "fill",
                    "color": "text.danger"
                  }
                ],
                "gap": 6,
                "h": 26,
                "align": "center",
                "visible": "{buy.state != \"ok\"}",
                "w": "fill"
              },
              {
                "type": "box",
                "layout": "row",
                "children": [],
                "h": "fill",
                "w": "fill"
              },
              {
                "type": "box",
                "layout": "row",
                "children": [
                  {
                    "type": "button",
                    "label": "Back",
                    "variant": "secondary",
                    "w": 130,
                    "h": 48,
                    "action": {
                      "event": "ui.close",
                      "args": {
                        "screen": "stall_buy"
                      }
                    }
                  },
                  {
                    "type": "box",
                    "layout": "row",
                    "children": [],
                    "w": "fill"
                  },
                  {
                    "type": "button",
                    "label": "{buy.state == \"ok\" ? \"Buy!\" : buy.state == \"funds\" ? \"Not enough\" : \"Bag full\"}",
                    "variant": "primary",
                    "icon": "coin",
                    "w": 200,
                    "h": 48,
                    "disabled": "{buy.state != \"ok\"}",
                    "id": "confirm",
                    "action": {
                      "event": "stall.buy",
                      "args": {
                        "stall": "{stall.header.stallId}",
                        "slot": "{buy.listing.slot}",
                        "qty": "{buy.qty}",
                        "revision": "{stall.revision}"
                      }
                    }
                  }
                ],
                "gap": 10,
                "h": 48,
                "align": "center",
                "w": "fill"
              },
              {
                "type": "box",
                "layout": "row",
                "children": [
                  {
                    "type": "keyhint",
                    "key": "A",
                    "label": "Confirm"
                  },
                  {
                    "type": "keyhint",
                    "key": "LS",
                    "label": "Amount"
                  },
                  {
                    "type": "keyhint",
                    "key": "B",
                    "label": "Back"
                  }
                ],
                "gap": 14,
                "h": 30,
                "w": "auto",
                "align": "center"
              }
            ]
          }
        ]
      }
    ],
    "w": "fill",
    "h": "fill"
  }
}
