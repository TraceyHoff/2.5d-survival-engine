{
  "$schema": "../screen.schema.json",
  "schema": "ui-screen/1",
  "id": "pause_settings",
  "setsState": {
    "ui.windowOpen": true
  },
  "title": "Pause + settings",
  "layer": "modal",
  "modal": true,
  "openWith": [
    "Escape"
  ],
  "root": {
    "type": "box",
    "id": "pause",
    "w": "fill",
    "h": "fill",
    "children": [
      {
        "type": "scrim",
        "alpha": 0.55
      },
      {
        "type": "box",
        "anchor": "cl",
        "x": 110,
        "y": 0,
        "w": 250,
        "h": 380,
        "children": [
          {
            "type": "ribbon",
            "text": "Paused",
            "anchor": "tc",
            "x": 0,
            "y": 0,
            "w": 240,
            "h": 40
          },
          {
            "type": "box",
            "anchor": "tl",
            "x": 5,
            "y": 60,
            "w": 240,
            "h": 320,
            "layout": "col",
            "gap": 12,
            "children": [
              {
                "type": "button",
                "label": "Resume",
                "variant": "primary",
                "w": "fill",
                "h": 52,
                "icon": "ic_arrow_right",
                "action": {
                  "event": "ui.close",
                  "args": {
                    "screen": "pause_settings"
                  }
                },
                "hotkey": "Escape"
              },
              {
                "type": "button",
                "label": "Settings",
                "variant": "gold",
                "w": "fill",
                "h": 52,
                "icon": "ic_gear",
                "action": {
                  "event": "settings.tab",
                  "args": {
                    "tab": "audio"
                  }
                }
              },
              {
                "type": "button",
                "label": "Invite friends",
                "variant": "info",
                "w": "fill",
                "h": 52,
                "icon": "ic_players",
                "action": {
                  "event": "session.copyInvite"
                }
              },
              {
                "type": "button",
                "label": "Leave camp",
                "variant": "danger",
                "w": "fill",
                "h": 52,
                "icon": "ic_home",
                "action": {
                  "event": "net.disconnect"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "box",
        "id": "pause_settings_window",
        "anchor": "cc",
        "x": 150,
        "y": 0,
        "w": 640,
        "h": 470,
        "children": [
          {
            "type": "panel",
            "id": "pause_settings_frame",
            "frame": "panel_wood",
            "anchor": "tl",
            "x": 0,
            "y": 0,
            "w": 640,
            "h": 470,
            "pad": 24,
            "children": [
              {
                "type": "tabs",
                "w": "fill",
                "h": 44,
                "bind": "{settings.tab}",
                "small": true,
                "items": [
                  {
                    "id": "game",
                    "label": "Game"
                  },
                  {
                    "id": "video",
                    "label": "Video"
                  },
                  {
                    "id": "audio",
                    "label": "Audio"
                  },
                  {
                    "id": "controls",
                    "label": "Keys"
                  },
                  {
                    "id": "access",
                    "label": "Comfort"
                  }
                ]
              },
              {
                "type": "panel",
                "frame": "panel_parchment",
                "anchor": "tl",
                "x": 0,
                "y": 44,
                "w": 592,
                "h": 356,
                "pad": 18,
                "layout": "col",
                "gap": 4,
                "children": [
                  {
                    "type": "box",
                    "layout": "row",
                    "gap": 10,
                    "h": 40,
                    "w": "fill",
                    "align": "center",
                    "children": [
                      {
                        "type": "text",
                        "text": "Master volume",
                        "font": "label",
                        "w": 200
                      },
                      {
                        "type": "slider",
                        "bind": "{settings.audio.master}",
                        "min": 0,
                        "max": 1,
                        "step": 0.05,
                        "w": "fill",
                        "h": 32,
                        "valueText": "{settings.audio.master|pct}"
                      }
                    ]
                  },
                  {
                    "type": "box",
                    "layout": "row",
                    "gap": 10,
                    "h": 40,
                    "w": "fill",
                    "align": "center",
                    "children": [
                      {
                        "type": "text",
                        "text": "Music",
                        "font": "label",
                        "w": 200
                      },
                      {
                        "type": "slider",
                        "bind": "{settings.audio.music}",
                        "min": 0,
                        "max": 1,
                        "step": 0.05,
                        "w": "fill",
                        "h": 32,
                        "valueText": "{settings.audio.music|pct}"
                      }
                    ]
                  },
                  {
                    "type": "box",
                    "layout": "row",
                    "gap": 10,
                    "h": 40,
                    "w": "fill",
                    "align": "center",
                    "children": [
                      {
                        "type": "text",
                        "text": "Sound effects",
                        "font": "label",
                        "w": 200
                      },
                      {
                        "type": "slider",
                        "bind": "{settings.audio.sfx}",
                        "min": 0,
                        "max": 1,
                        "step": 0.05,
                        "w": "fill",
                        "h": 32,
                        "valueText": "{settings.audio.sfx|pct}"
                      }
                    ]
                  },
                  {
                    "type": "divider",
                    "w": "fill",
                    "h": 14
                  },
                  {
                    "type": "box",
                    "layout": "row",
                    "gap": 10,
                    "h": 40,
                    "w": "fill",
                    "align": "center",
                    "children": [
                      {
                        "type": "text",
                        "text": "UI scale",
                        "font": "label",
                        "w": 200
                      },
                      {
                        "type": "slider",
                        "bind": "{settings.ui.scale}",
                        "min": 1,
                        "max": 2,
                        "step": 0.25,
                        "w": "fill",
                        "h": 32,
                        "valueText": "{settings.ui.scale}x"
                      }
                    ]
                  },
                  {
                    "type": "box",
                    "layout": "row",
                    "gap": 10,
                    "h": 40,
                    "w": "fill",
                    "align": "center",
                    "children": [
                      {
                        "type": "text",
                        "text": "Big text",
                        "font": "label",
                        "w": 200
                      },
                      {
                        "type": "toggle",
                        "bind": "{settings.access.largeText}",
                        "w": 48,
                        "h": 28
                      }
                    ]
                  },
                  {
                    "type": "box",
                    "layout": "row",
                    "gap": 10,
                    "h": 40,
                    "w": "fill",
                    "align": "center",
                    "children": [
                      {
                        "type": "text",
                        "text": "Reduce motion",
                        "font": "label",
                        "w": 200
                      },
                      {
                        "type": "toggle",
                        "bind": "{settings.access.reduceMotion}",
                        "w": 48,
                        "h": 28
                      }
                    ]
                  },
                  {
                    "type": "box",
                    "layout": "row",
                    "gap": 10,
                    "h": 40,
                    "w": "fill",
                    "align": "center",
                    "children": [
                      {
                        "type": "text",
                        "text": "Colour-blind icons",
                        "font": "label",
                        "w": 200
                      },
                      {
                        "type": "checkbox",
                        "bind": "{settings.access.shapeCues}",
                        "w": 32,
                        "h": 32,
                        "label": "Shapes + patterns on bars"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "ribbon",
            "text": "Settings",
            "anchor": "tc",
            "x": 0,
            "y": -18,
            "w": 268,
            "h": 40
          },
          {
            "type": "button",
            "id": "close",
            "variant": "close",
            "anchor": "tr",
            "x": 10,
            "y": -10,
            "w": 32,
            "h": 32,
            "action": {
              "event": "ui.close",
              "args": {
                "screen": "pause_settings"
              }
            },
            "hotkey": "Escape",
            "tooltip": "Close (Esc)"
          }
        ]
      }
    ]
  },
  "note": "Multiplayer: the sim does not pause; 'Paused' only captures input locally."
}
