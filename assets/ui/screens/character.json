{
 "$schema": "./screen.schema.json",
 "schema": "ui-screen/1",
 "id": "character",
 "setsState": {
  "ui.windowOpen": true
 },
 "title": "Player status / character sheet",
 "layer": "window",
 "modal": false,
 "openWith": [
  "KeyK"
 ],
 "derive": {
  "statRows": [
   {
    "icon": "ic_weight",
    "label": "Carry weight",
    "value": "{inventory.weight|fixed1} / {inventory.maxWeight} kg"
   },
   {
    "icon": "vital_temp",
    "label": "Body temperature",
    "value": "{player.vitals.bodyTemp|fixed1} \u00b0C"
   },
   {
    "icon": "vital_cold",
    "label": "Feels like",
    "value": "{player.vitals.feltTemp|int} \u00b0C"
   },
   {
    "icon": "st_wet",
    "label": "Wetness",
    "value": "{player.vitals.wetness|pct}"
   },
   {
    "icon": "st_cold",
    "label": "Insulation",
    "value": "+{player.stats.insulation|int} \u00b0C"
   },
   {
    "icon": "ic_zombie",
    "label": "Zombies poofed",
    "value": "{player.stats.kills}"
   },
   {
    "icon": "ic_day",
    "label": "Days survived",
    "value": "{player.stats.days}"
   }
  ]
 },
 "root": {
  "type": "box",
  "w": "fill",
  "h": "fill",
  "children": [
   {
    "type": "scrim",
    "alpha": 0.35
   },
   {
    "type": "box",
    "id": "character_window",
    "anchor": "cc",
    "x": 0,
    "y": 0,
    "w": 900,
    "h": 500,
    "children": [
     {
      "type": "include",
      "src": "_partials/journal_tabs.json",
      "params": {
       "active": "character"
      },
      "anchor": "tl",
      "x": 28,
      "y": -40
     },
     {
      "type": "panel",
      "id": "character_frame",
      "frame": "panel_wood_vine",
      "anchor": "tl",
      "x": 0,
      "y": 0,
      "w": 900,
      "h": 500,
      "pad": 24,
      "children": [
       {
        "type": "panel",
        "frame": "panel_inset",
        "anchor": "tl",
        "x": 0,
        "y": 4,
        "w": 250,
        "h": 430,
        "pad": 12,
        "layout": "col",
        "gap": 8,
        "align": "center",
        "children": [
         {
          "type": "portrait",
          "bind": "{player.appearance}",
          "w": 120,
          "h": 200
         },
         {
          "type": "text",
          "text": "{player.name}",
          "font": "heading",
          "h": 26,
          "align": "center",
          "w": "fill"
         },
         {
          "type": "badge",
          "text": "Level {player.xp.level} Camper",
          "color": "plum-500",
          "w": 160,
          "h": 24
         },
         {
          "type": "bar",
          "vital": "xp",
          "value": "{player.xp.value}",
          "max": "{player.xp.next}",
          "w": "fill",
          "h": 20,
          "showText": true
         },
         {
          "type": "text",
          "text": "{player.xp.value} / {player.xp.next} XP",
          "font": "tiny",
          "h": 16,
          "align": "center",
          "w": "fill"
         }
        ]
       },
       {
        "type": "panel",
        "frame": "panel_parchment",
        "anchor": "tl",
        "x": 266,
        "y": 4,
        "w": 300,
        "h": 430,
        "pad": 16,
        "layout": "col",
        "gap": 6,
        "children": [
         {
          "type": "text",
          "text": "Vitals",
          "font": "heading",
          "h": 24
         },
         {
          "type": "box",
          "layout": "row",
          "gap": 8,
          "h": 32,
          "w": "fill",
          "align": "center",
          "children": [
           {
            "type": "icon",
            "icon": "vital_health",
            "w": 28,
            "h": 28
           },
           {
            "type": "bar",
            "vital": "health",
            "value": "{player.vitals.health}",
            "max": "{player.vitals.healthMax}",
            "w": "fill",
            "h": 20
           },
           {
            "type": "text",
            "text": "{player.vitals.health|int}/{player.vitals.healthMax|int}",
            "font": "small",
            "w": 56,
            "align": "right"
           }
          ]
         },
         {
          "type": "box",
          "layout": "row",
          "gap": 8,
          "h": 32,
          "w": "fill",
          "align": "center",
          "children": [
           {
            "type": "icon",
            "icon": "vital_hunger",
            "w": 28,
            "h": 28
           },
           {
            "type": "bar",
            "vital": "hunger",
            "value": "{player.vitals.hunger}",
            "max": "{100}",
            "w": "fill",
            "h": 20
           },
           {
            "type": "text",
            "text": "{player.vitals.hunger|int}/{100|int}",
            "font": "small",
            "w": 56,
            "align": "right"
           }
          ]
         },
         {
          "type": "box",
          "layout": "row",
          "gap": 8,
          "h": 32,
          "w": "fill",
          "align": "center",
          "children": [
           {
            "type": "icon",
            "icon": "vital_thirst",
            "w": 28,
            "h": 28
           },
           {
            "type": "bar",
            "vital": "thirst",
            "value": "{player.vitals.thirst}",
            "max": "{100}",
            "w": "fill",
            "h": 20
           },
           {
            "type": "text",
            "text": "{player.vitals.thirst|int}/{100|int}",
            "font": "small",
            "w": 56,
            "align": "right"
           }
          ]
         },
         {
          "type": "box",
          "layout": "row",
          "gap": 8,
          "h": 32,
          "w": "fill",
          "align": "center",
          "children": [
           {
            "type": "icon",
            "icon": "vital_stamina",
            "w": 28,
            "h": 28
           },
           {
            "type": "bar",
            "vital": "stamina",
            "value": "{player.vitals.stamina}",
            "max": "{player.vitals.staminaMax}",
            "w": "fill",
            "h": 20
           },
           {
            "type": "text",
            "text": "{player.vitals.stamina|int}/{player.vitals.staminaMax|int}",
            "font": "small",
            "w": 56,
            "align": "right"
           }
          ]
         },
         {
          "type": "divider",
          "w": "fill",
          "h": 14
         },
         {
          "type": "repeat",
          "each": "{statRows}",
          "as": "s",
          "layout": "col",
          "gap": 2,
          "w": "fill",
          "h": "auto",
          "template": {
           "type": "statrow",
           "icon": "{s.icon}",
           "label": "{s.label}",
           "value": "{s.value}",
           "w": "fill",
           "h": 24
          }
         }
        ]
       },
       {
        "type": "panel",
        "frame": "panel_inset",
        "anchor": "tl",
        "x": 582,
        "y": 4,
        "w": 270,
        "h": 430,
        "pad": 12,
        "layout": "col",
        "gap": 8,
        "children": [
         {
          "type": "text",
          "text": "Feeling",
          "font": "heading",
          "h": 24
         },
         {
          "type": "repeat",
          "each": "{player.effects}",
          "as": "fx",
          "layout": "col",
          "gap": 6,
          "w": "fill",
          "h": 200,
          "template": {
           "type": "box",
           "layout": "row",
           "gap": 8,
           "h": 44,
           "w": "fill",
           "align": "center",
           "children": [
            {
             "type": "status",
             "icon": "{fx.icon}",
             "w": 40,
             "h": 40,
             "tone": "{fx.tone}"
            },
            {
             "type": "box",
             "layout": "col",
             "w": "fill",
             "h": 40,
             "children": [
              {
               "type": "text",
               "text": "{fx.label}",
               "font": "label",
               "h": 20
              },
              {
               "type": "text",
               "text": "{fx.description}",
               "font": "tiny",
               "h": 16
              }
             ]
            }
           ]
          }
         },
         {
          "type": "divider",
          "w": "fill",
          "h": 14
         },
         {
          "type": "text",
          "text": "Skills",
          "font": "heading",
          "h": 24
         },
         {
          "type": "repeat",
          "each": "{player.skills}",
          "as": "sk",
          "layout": "col",
          "gap": 4,
          "w": "fill",
          "h": "auto",
          "template": {
           "type": "box",
           "layout": "row",
           "gap": 6,
           "h": 26,
           "w": "fill",
           "align": "center",
           "children": [
            {
             "type": "icon",
             "icon": "{sk.icon}",
             "w": 24,
             "h": 24
            },
            {
             "type": "text",
             "text": "{sk.label}",
             "font": "small",
             "w": 80
            },
            {
             "type": "pips",
             "value": "{sk.level}",
             "max": 5,
             "w": "fill",
             "h": 16
            }
           ]
          }
         }
        ]
       }
      ]
     },
     {
      "type": "button",
      "id": "close",
      "variant": "close",
      "anchor": "tr",
      "x": 10,
      "y": -10,
      "w": 32,
      "h": 32,
      "action": {
       "event": "ui.close",
       "args": {
        "screen": "character"
       }
      },
      "hotkey": "Escape",
      "tooltip": "Close (Esc)"
     }
    ]
   }
  ]
 }
}