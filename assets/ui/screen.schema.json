{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "screen.schema.json",
 "title": "Cozy Camp UI screen (ui-screen/1, ui-partial/1)",
 "description": "Mirrors @engine/assets validateUiScreen (UI_WIDGET_TYPES, ADR-082 charpreview/cosmeticslot rules). Widgets are {type,...} nodes anywhere in the tree.",
 "type": "object",
 "properties": {
  "schema": {
   "enum": [
    "ui-screen/1",
    "ui-partial/1"
   ]
  },
  "id": {
   "type": "string"
  },
  "root": {
   "$ref": "#/$defs/node"
  }
 },
 "required": [
  "schema"
 ],
 "$defs": {
  "binding": {
   "type": "string",
   "pattern": "^\\{[^{}]+\\}$"
  },
  "node": {
   "type": "object",
   "properties": {
    "type": {
     "enum": [
      "avatar",
      "backdrop",
      "badge",
      "banner",
      "bar",
      "box",
      "button",
      "card",
      "chatline",
      "checkbox",
      "divider",
      "foodbadge",
      "ghost",
      "icon",
      "include",
      "input",
      "keyhint",
      "list",
      "listitem",
      "lockstamp",
      "logo",
      "mapview",
      "minimap",
      "panel",
      "pips",
      "portrait",
      "rank",
      "repeat",
      "ribbon",
      "scrim",
      "slider",
      "slot",
      "stat",
      "statrow",
      "status",
      "stepper",
      "swatch",
      "tabs",
      "text",
      "toast",
      "toggle",
      "tooltip",
      "charpreview",
      "cosmeticslot"
     ]
    },
    "children": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/node"
     }
    },
    "template": {
     "$ref": "#/$defs/node"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "type": {
        "const": "charpreview"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [
       "appearance"
      ],
      "properties": {
       "appearance": {
        "type": "string",
        "pattern": "^\\{[^{}]+\\}$"
       },
       "rotate": {
        "type": [
         "boolean",
         "number"
        ]
       },
       "zoom": {
        "oneOf": [
         {
          "type": "boolean"
         },
         {
          "type": "number",
          "exclusiveMinimum": 0
         }
        ]
       },
       "anim": {
        "type": "string",
        "pattern": "^(\\{[^{}]+\\}|[a-z0-9_]+)$"
       },
       "expression": {
        "type": "string",
        "pattern": "^(\\{[^{}]+\\}|[a-z0-9_]+)$"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "cosmeticslot"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [
       "slot"
      ],
      "properties": {
       "slot": {
        "anyOf": [
         {
          "type": "string",
          "pattern": "^\\{[^{}]+\\}$"
         },
         {
          "enum": [
           "hair",
           "face",
           "eyes",
           "hat",
           "top",
           "bottom",
           "shoes",
           "accessory"
          ]
         }
        ]
       },
       "bodyType": {
        "anyOf": [
         {
          "type": "string",
          "pattern": "^\\{[^{}]+\\}$"
         },
         {
          "enum": [
           "male",
           "female"
          ]
         }
        ]
       },
       "unlocked": {
        "anyOf": [
         {
          "type": "string",
          "pattern": "^\\{[^{}]+\\}$"
         },
         {
          "enum": [
           "all",
           "unlocked",
           "locked"
          ]
         }
        ]
       },
       "paletteChannel": {
        "enum": [
         "primary",
         "secondary",
         "none"
        ]
       }
      }
     }
    }
   ]
  }
 }
}