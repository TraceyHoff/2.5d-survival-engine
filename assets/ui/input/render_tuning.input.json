{
 "$doc": "Renderer + DOM tuning for multi-input presentation. Colours are sRGB hex (#RRGGBB or #RRGGBBAA). Sizes in CSS px at 1x (dp on touch). Owner: ui/ (Cozy Camp). Consumed by the screen-space overlay layer (focus outlines, world prompts, placement ghosts) and the DOM UI.",
 "version": 1,
 "focus": {
  "gamepad": {"frame": "input_focus_gamepad", "nineSlice": 16, "outline": "#FFD45A", "outlineInner": "#3B2433", "widthPx": 3, "innerWidthPx": 2, "offsetPx": 3,
              "pulse": {"enabled": true, "periodMs": 1400, "scaleMin": 1.0, "scaleMax": 1.035, "alphaMin": 0.75, "alphaMax": 1.0, "ease": "sine"},
              "moveTweenMs": 110, "moveEase": "cubic-out", "glow": {"color": "#FFD45A66", "blurPx": 8}, "sfx": "ui_tick"},
  "gamepadDragging": {"frame": "input_focus_gamepad_drag", "outline": "#7BD389", "widthPx": 3, "pulse": {"enabled": true, "periodMs": 700, "scaleMin": 1.0, "scaleMax": 1.06, "alphaMin": 0.85, "alphaMax": 1.0, "ease": "sine"}, "carriedItemOffsetPx": {"x": 10, "y": -12}},
  "kbm": {"frame": "input_focus_kbm", "nineSlice": 16, "outline": "#3A9CCC", "widthPx": 2, "offsetPx": 2, "pulse": {"enabled": false}, "showOnlyForKeyboardNav": true, "hover": {"lift": -2, "brighten": 0.06, "tooltipDelayMs": 350}},
  "touch": {"frame": "input_focus_touch", "nineSlice": 16, "outline": "#FFFAF0", "widthPx": 3, "offsetPx": 0, "pulse": {"enabled": false}, "showOn": "selection only (tap-to-select)", "selectedTint": "#FFD45A33"}
 },
 "press": {
  "touchButton": {"scalePressed": 0.92, "downMs": 40, "upMs": 120, "ease": "back-out", "haptic": {"enabled": true, "ms": 8}, "spriteSuffix": {"normal": "_normal", "pressed": "_pressed", "disabled": "_disabled"}},
  "tapPulse": {"sprite": "input_tap_pulse", "durationMs": 260, "scaleFrom": 0.4, "scaleTo": 1.2, "alphaFrom": 0.8, "alphaTo": 0},
  "holdToSplit": {"sprites": ["input_split_ring_0","input_split_ring_1","input_split_ring_2","input_split_ring_3","input_split_ring_4","input_split_ring_5","input_split_ring_6","input_split_ring_7"], "holdMs": 450, "cancelSlopDp": 12, "result": "half stack (UI.SplitStack); keep holding 900ms more -> amount slider"}
 },
 "worldPrompt": {
  "font": {"atlas": "fonts/sdf/font_prompt.json", "type": "mtsdf", "sizePx": 15, "fill": "#FFFAF0", "outline": "#3B2433", "outlineWidthPx": 2.2, "shadow": {"dx": 0, "dy": 2, "softness": 0.25, "color": "#3B2433A6"}},
  "chip": {"frame": "input_prompt_chip", "nineSlice": [14,12,14,12], "padX": 8, "padY": 4, "gapPx": 6, "glyphSizePx": 24},
  "anchor": {"worldOffsetZ": 1.6, "screenOffsetY": -10, "clampToSafeArea": true, "maxVisible": 1, "fadeInMs": 120, "fadeOutMs": 90, "bobPx": 1.5, "bobPeriodMs": 1800},
  "holdRing": {"color": "#FFD45A", "trackColor": "#3B243366", "widthPx": 3, "radiusPx": 15},
  "deviceSwap": {"crossfadeMs": 140, "debounceMs": 250}
 },
 "ghost": {
  "valid": {"tint": "#7BD389", "alpha": 0.55, "outline": "#2F8A4A", "outlineWidthPx": 2, "tile": "input_tile_valid"},
  "invalid": {"tint": "#F06A5A", "alpha": 0.5, "outline": "#A8323A", "outlineWidthPx": 2, "tile": "input_tile_invalid", "shakePx": 2, "shakeMs": 160},
  "snap": {"tile": "input_tile_snap", "pulsePeriodMs": 900},
  "occupied": {"tile": "input_tile_occupied"}, "hover": {"tile": "input_tile_hover"}, "claim": {"tile": "input_tile_claim"},
  "grid": {"tile": "input_tile_grid", "tileW": 64, "tileH": 32, "radiusCells": 6, "fadeEdge": 0.5, "alpha": 0.6},
  "touch": {"liftPx": 72, "handle": "input_ghost_handle", "dragShadow": "input_drag_shadow", "confirmRequired": true, "twoFingerRotateSnapDeg": 90, "pinchZoom": {"min": 0.6, "max": 1.8}}
 },
 "radial": {"ring": "input_rad_ring", "segment": "input_rad_seg", "segmentHighlight": "input_rad_seg_hi", "hub": "input_rad_hub",
            "highlight": {"scale": 1.08, "outline": "#FFD45A", "widthPx": 3}, "openMs": 140, "closeMs": 90, "deadzone": 0.35, "stickSelect": "right stick", "itemIconPx": 36},
 "joystick": {"opacityIdle": 0.72, "opacityActive": 1.0, "knobTravel": 0.62},
 "tooltipHotkey": {"glyphSizePx": 20, "position": "right of title", "showFor": ["kbm"]}
}
