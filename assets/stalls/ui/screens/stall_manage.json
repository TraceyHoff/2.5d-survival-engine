{
 "$schema": "../../../ui/screens/screen.schema.json",
 "schema": "ui-screen/1",
 "id": "stall_manage",
 "title": "Manage stall",
 "layer": "window",
 "modal": false,
 "setsState": {
  "ui.windowOpen": true
 },
 "opens": "owner (or clan member with any right) interacts with own stall; Shift/hold-interact on clan stall",
 "input": {
  "touch": "tap = focus+activate, long-press = inspect, swipe grid scrolls; min hit 48px",
  "gamepad": "D-pad/LS moves focus over focusOrder; A activate, X inspect, Y sort, LB/RB filter tabs, B back",
  "kbm": "click, wheel scroll, / focuses search, Enter buy, I inspect, Esc close"
 },
 "sends": "stall.list {invSlot, listingSlot, qty, price{item,count}} | stall.setPrice {slot, item?, count|delta} | stall.stock {slot, invSlot, count} | stall.enable {slot, enabled} | stall.collect {stall} | stall.setOpen {stall, open} | stall.remove {slot}",
 "permissions": "clan stalls: leader+officer list/price/collect, member stock only, recruit buy only (StallActs). Disabled controls show ic_lock + tooltip stall.viewer.lockReason.<act>",
 "root": {
  "type": "box",
  "layout": "abs",
  "children": [
   {
    "type": "scrim",
    "alpha": 0.3
   },
   {
    "type": "panel",
    "frame": "panel_wood_vine",
    "anchor": "cc",
    "w": 1180,
    "h": 640,
    "pad": 22,
    "layout": "col",
    "gap": 8,
    "children": [
     {
      "type": "panel",
      "frame": "panel_parchment",
      "w": "fill",
      "h": "fill",
      "pad": 14,
      "layout": "col",
      "gap": 10,
      "children": [
       {
        "type": "box",
        "layout": "row",
        "children": [
         {
          "type": "icon",
          "icon": "ui_stall_stall",
          "w": 36,
          "h": 36
         },
         {
          "type": "box",
          "layout": "row",
          "children": [
           {
            "type": "input",
            "bind": "{stall.sign.name}",
            "maxLength": 24,
            "placeholder": "Sign text (24 max)",
            "w": 300,
            "h": 40,
            "disabled": "{!stall.viewer.perms.list}",
            "action": {
             "event": "stall.rename",
             "args": {
              "name": "$value"
             }
            }
           },
           {
            "type": "text",
            "text": "{stall.header.ownerKind == 2 ? \"Clan stall · [\" + stall.header.clanTag + \"] · you are \" + stall.viewer.roleLabel : \"Your stall\"}",
            "font": "small",
            "w": "auto",
            "color": "text.secondary"
           }
          ],
          "w": 640,
          "gap": 12,
          "h": 40,
          "align": "center"
         },
         {
          "type": "box",
          "layout": "row",
          "children": [],
          "w": "fill"
         },
         {
          "type": "text",
          "text": "{stall.header.open ? \"Open for trade\" : \"Closed\"}",
          "font": "label",
          "w": "auto"
         },
         {
          "type": "toggle",
          "bind": "{stall.header.open}",
          "w": 56,
          "h": 32,
          "id": "open",
          "disabled": "{!stall.viewer.perms.list}",
          "action": {
           "event": "stall.setOpen",
           "args": {
            "stall": "{stall.header.stallId}",
            "open": "$value"
           }
          }
         },
         {
          "type": "icon",
          "icon": "{stall.viewer.perms.list ? \"\" : \"ic_lock\"}",
          "w": 20,
          "h": 20
         }
        ],
        "gap": 10,
        "h": 44,
        "w": "fill",
        "align": "center"
       },
       {
        "type": "tabs",
        "bind": "{manage.tab}",
        "w": 520,
        "h": 40,
        "items": [
         {
          "id": "listings",
          "label": "Listings",
          "icon": "ui_stall_tag"
         },
         {
          "id": "till",
          "label": "Till & Ledger",
          "icon": "ui_stall_till"
         },
         {
          "id": "perms",
          "label": "Clan rights",
          "icon": "ui_stall_clan_key"
         }
        ],
        "action": {
         "event": "manage.tab",
         "args": {
          "tab": "$id"
         }
        }
       },
       {
        "type": "box",
        "layout": "row",
        "children": [
         {
          "type": "panel",
          "frame": "panel_inset",
          "w": "fill",
          "h": "fill",
          "pad": 8,
          "layout": "col",
          "gap": 4,
          "children": [
           {
            "type": "box",
            "layout": "row",
            "children": [
             {
              "type": "text",
              "text": "Item",
              "font": "tiny",
              "w": 226
             },
             {
              "type": "text",
              "text": "Price (each sale)",
              "font": "tiny",
              "w": 150
             },
             {
              "type": "text",
              "text": "Paid in",
              "font": "tiny",
              "w": 74
             },
             {
              "type": "text",
              "text": "Qty",
              "font": "tiny",
              "w": 36
             },
             {
              "type": "text",
              "text": "",
              "font": "tiny",
              "w": 92
             },
             {
              "type": "text",
              "text": "On",
              "font": "tiny",
              "w": 56
             }
            ],
            "gap": 8,
            "h": 16,
            "pad": [
             0,
             8,
             0,
             64
            ],
            "w": "fill"
           },
           {
            "type": "list",
            "w": "fill",
            "h": "fill",
            "children": [
             {
              "type": "repeat",
              "each": "{stall.listings}",
              "as": "l",
              "layout": "col",
              "gap": 4,
              "w": "fill",
              "h": "auto",
              "template": {
               "type": "box",
               "layout": "row",
               "children": [
                {
                 "type": "slot",
                 "w": 48,
                 "h": 48,
                 "bind": "{l.item}",
                 "showCount": false
                },
                {
                 "type": "box",
                 "layout": "col",
                 "children": [
                  {
                   "type": "text",
                   "text": "{l.item.name}",
                   "font": "label",
                   "h": 18
                  },
                  {
                   "type": "text",
                   "text": "{l.stock} in stock · sold {l.sold}",
                   "font": "tiny",
                   "h": 14,
                   "color": "text.muted"
                  }
                 ],
                 "w": 170,
                 "h": 36
                },
                {
                 "type": "box",
                 "layout": "row",
                 "children": [
                  {
                   "type": "button",
                   "variant": "secondary",
                   "w": 32,
                   "h": 32,
                   "icon": "{stall.viewer.perms.price ? \"ic_minus\" : \"ic_lock\"}",
                   "action": {
                    "event": "stall.setPrice",
                    "args": {
                     "slot": "{l.slot}",
                     "delta": -1
                    }
                   },
                   "disabled": "{!stall.viewer.perms.price}",
                   "tooltip": "{stall.viewer.perms.price ? \"\" : stall.viewer.lockReason.price}",
                   "focusable": true
                  },
                  {
                   "type": "box",
                   "layout": "row",
                   "children": [
                    {
                     "type": "icon",
                     "icon": "{l.price.icon}",
                     "w": 20,
                     "h": 20
                    },
                    {
                     "type": "text",
                     "text": "{l.price.count}",
                     "font": "heading",
                     "w": "auto"
                    }
                   ],
                   "gap": 3,
                   "w": 62,
                   "h": 32,
                   "align": "center",
                   "justify": "center"
                  },
                  {
                   "type": "button",
                   "variant": "secondary",
                   "w": 32,
                   "h": 32,
                   "icon": "{stall.viewer.perms.price ? \"ic_plus\" : \"ic_lock\"}",
                   "action": {
                    "event": "stall.setPrice",
                    "args": {
                     "slot": "{l.slot}",
                     "delta": 1
                    }
                   },
                   "disabled": "{!stall.viewer.perms.price}",
                   "tooltip": "{stall.viewer.perms.price ? \"\" : stall.viewer.lockReason.price}",
                   "focusable": true
                  }
                 ],
                 "gap": 4,
                 "w": 150,
                 "h": 32,
                 "align": "center"
                },
                {
                 "type": "button",
                 "variant": "info",
                 "label": "Item",
                 "w": 74,
                 "h": 32,
                 "icon": "{stall.viewer.perms.price ? \"ui_stall_tag\" : \"ic_lock\"}",
                 "action": {
                  "event": "stall.pickPriceItem",
                  "args": {
                   "slot": "{l.slot}"
                  }
                 },
                 "disabled": "{!stall.viewer.perms.price}",
                 "tooltip": "{stall.viewer.perms.price ? \"\" : stall.viewer.lockReason.price}",
                 "focusable": true
                },
                {
                 "type": "text",
                 "text": "x{l.qty}",
                 "font": "label",
                 "w": 36
                },
                {
                 "type": "button",
                 "variant": "primary",
                 "label": "Stock",
                 "w": 92,
                 "h": 32,
                 "icon": "{stall.viewer.perms.stock ? \"ui_stall_restock\" : \"ic_lock\"}",
                 "action": {
                  "event": "stall.stock",
                  "args": {
                   "slot": "{l.slot}"
                  }
                 },
                 "disabled": "{!stall.viewer.perms.stock}",
                 "tooltip": "{stall.viewer.perms.stock ? \"\" : stall.viewer.lockReason.stock}",
                 "focusable": true
                },
                {
                 "type": "toggle",
                 "bind": "{l.enabled}",
                 "w": 56,
                 "h": 32,
                 "disabled": "{!stall.viewer.perms.list}",
                 "tooltip": "{stall.viewer.perms.list ? \"\" : stall.viewer.lockReason.list}",
                 "action": {
                  "event": "stall.enable",
                  "args": {
                   "slot": "{l.slot}",
                   "enabled": "$value"
                  }
                 }
                },
                {
                 "type": "icon",
                 "icon": "{stall.viewer.perms.list ? \"\" : \"ic_lock\"}",
                 "w": 18,
                 "h": 18
                }
               ],
               "gap": 8,
               "h": 56,
               "w": "fill",
               "align": "center",
               "pad": [
                4,
                8,
                4,
                8
               ],
               "focusable": true
              }
             }
            ]
           },
           {
            "type": "box",
            "layout": "row",
            "children": [
             {
              "type": "button",
              "label": "List item from bag…",
              "variant": "primary",
              "icon": "{stall.viewer.perms.list ? \"ic_plus\" : \"ic_lock\"}",
              "w": 240,
              "h": 44,
              "action": {
               "event": "ui.open",
               "args": {
                "screen": "stall_list_item"
               }
              },
              "disabled": "{!stall.viewer.perms.list}",
              "tooltip": "{stall.viewer.perms.list ? \"\" : stall.viewer.lockReason.list}",
              "focusable": true
             },
             {
              "type": "text",
              "text": "{stall.listings.length}/{stall.header.listingCount} listing slots",
              "font": "small",
              "w": "fill",
              "color": "text.muted"
             }
            ],
            "gap": 12,
            "h": 44,
            "align": "center",
            "w": "fill"
           }
          ]
         },
         {
          "type": "panel",
          "frame": "panel_inset",
          "w": 300,
          "h": "fill",
          "pad": 12,
          "layout": "col",
          "gap": 8,
          "children": [
           {
            "type": "box",
            "layout": "row",
            "children": [
             {
              "type": "icon",
              "icon": "ui_stall_till",
              "w": 28,
              "h": 28
             },
             {
              "type": "text",
              "text": "Till",
              "font": "heading",
              "w": "fill"
             },
             {
              "type": "text",
              "text": "{manage.till.totalText}",
              "font": "label",
              "w": "auto"
             }
            ],
            "gap": 6,
            "h": 30,
            "w": "fill",
            "align": "center"
           },
           {
            "type": "repeat",
            "each": "{manage.till.items}",
            "as": "t",
            "layout": "grid",
            "cols": 5,
            "cell": [
             48,
             48
            ],
            "gap": 4,
            "template": {
             "type": "slot",
             "w": 48,
             "h": 48,
             "bind": "{t}"
            }
           },
           {
            "type": "button",
            "label": "Collect all",
            "variant": "gold",
            "icon": "{stall.viewer.perms.collect ? \"coin\" : \"ic_lock\"}",
            "w": "fill",
            "h": 44,
            "id": "collect",
            "action": {
             "event": "stall.collect",
             "args": {
              "stall": "{stall.header.stallId}"
             }
            },
            "disabled": "{!stall.viewer.perms.collect}",
            "tooltip": "{stall.viewer.perms.collect ? \"\" : stall.viewer.lockReason.collect}",
            "focusable": true
           },
           {
            "type": "divider",
            "w": "fill",
            "h": 14
           },
           {
            "type": "box",
            "layout": "row",
            "children": [
             {
              "type": "icon",
              "icon": "ui_stall_ledger",
              "w": 24,
              "h": 24
             },
             {
              "type": "text",
              "text": "Ledger",
              "font": "heading",
              "w": "fill"
             },
             {
              "type": "text",
              "text": "{manage.ledgerTotal} sales",
              "font": "tiny",
              "w": 70,
              "align": "right",
              "color": "text.muted"
             }
            ],
            "gap": 6,
            "h": 26,
            "w": "fill",
            "align": "center"
           },
           {
            "type": "list",
            "w": "fill",
            "h": "fill",
            "children": [
             {
              "type": "repeat",
              "each": "{manage.ledger}",
              "as": "e",
              "layout": "col",
              "gap": 2,
              "w": "fill",
              "h": "auto",
              "template": {
               "type": "box",
               "layout": "row",
               "children": [
                {
                 "type": "icon",
                 "icon": "{e.icon}",
                 "w": 20,
                 "h": 20
                },
                {
                 "type": "text",
                 "text": "{e.buyerName} bought {e.count}",
                 "font": "tiny",
                 "w": "fill"
                },
                {
                 "type": "icon",
                 "icon": "{e.priceIcon}",
                 "w": 16,
                 "h": 16
                },
                {
                 "type": "text",
                 "text": "{e.priceCount}",
                 "font": "tiny",
                 "w": 26
                },
                {
                 "type": "text",
                 "text": "{e.ago}",
                 "font": "tiny",
                 "w": 34,
                 "color": "text.muted"
                }
               ],
               "gap": 4,
               "h": 22,
               "w": "fill",
               "align": "center"
              }
             }
            ]
           }
          ]
         }
        ],
        "gap": 12,
        "h": "fill",
        "w": "fill"
       },
       {
        "type": "box",
        "layout": "row",
        "children": [
         {
          "type": "keyhint",
          "key": "A",
          "label": "Edit"
         },
         {
          "type": "keyhint",
          "key": "LS",
          "label": "Price"
         },
         {
          "type": "keyhint",
          "key": "X",
          "label": "Stock"
         },
         {
          "type": "keyhint",
          "key": "Y",
          "label": "On/Off"
         },
         {
          "type": "keyhint",
          "key": "LB RB",
          "label": "Tabs"
         },
         {
          "type": "keyhint",
          "key": "B",
          "label": "Close"
         }
        ],
        "gap": 14,
        "h": 30,
        "w": "auto",
        "align": "center"
       }
      ]
     }
    ]
   }
  ],
  "w": "fill",
  "h": "fill"
 }
}