{
 "schema": "ui-partial/1",
 "params": {
  "item": "{hover.item}"
 },
 "root": {
  "type": "box",
  "layout": "row",
  "children": [
   {
    "type": "icon",
    "icon": "ui_maker_mark",
    "w": 18,
    "h": 18
   },
   {
    "type": "text",
    "text": "{\"Crafted by \" + $item.crafterName}",
    "font": "small",
    "w": "fill",
    "color": "text.secondary"
   }
  ],
  "gap": 6,
  "h": 20,
  "w": "fill",
  "align": "center",
  "visible": "{$item.crafterId > 0}",
  "comment": "crafterId 0 = gathered -> hidden. crafterName resolved client-side from the PlayerNameDirectory (follows renames); unknown id -> \"a wanderer\"."
 }
}