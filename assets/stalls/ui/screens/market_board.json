{
 "$schema": "../../../ui/screens/screen.schema.json",
 "schema": "ui-screen/1",
 "id": "market_board",
 "title": "Market board",
 "layer": "window",
 "modal": false,
 "setsState": {
  "ui.windowOpen": true
 },
 "opens": "interact with a market board piece (proposed) or the map tab",
 "binds": "market.results[] from cached stall headers + last-seen listings (client-side index; server search message proposed, see DATA_PATHS.md)",
 "input": {
  "touch": "tap = focus+activate, long-press = inspect, swipe grid scrolls; min hit 48px",
  "gamepad": "D-pad/LS moves focus over focusOrder; A activate, X inspect, Y sort, LB/RB filter tabs, B back",
  "kbm": "click, wheel scroll, / focuses search, Enter buy, I inspect, Esc close"
 },
 "root": {
  "type": "box",
  "layout": "abs",
  "children": [
   {
    "type": "scrim",
    "alpha": 0.3
   },
   {
    "type": "panel",
    "frame": "panel_wood_vine",
    "anchor": "cc",
    "w": 900,
    "h": 600,
    "pad": 22,
    "layout": "col",
    "gap": 8,
    "children": [
     {
      "type": "panel",
      "frame": "panel_parchment",
      "w": "fill",
      "h": "fill",
      "pad": 16,
      "layout": "col",
      "gap": 10,
      "children": [
       {
        "type": "box",
        "layout": "row",
        "children": [
         {
          "type": "icon",
          "icon": "ui_stall_ledger",
          "w": 32,
          "h": 32
         },
         {
          "type": "text",
          "text": "Market board",
          "font": "title",
          "w": "fill"
         },
         {
          "type": "text",
          "text": "{market.results.length} offers nearby",
          "font": "small",
          "w": "auto",
          "color": "text.muted"
         }
        ],
        "gap": 8,
        "h": 40,
        "align": "center",
        "w": "fill"
       },
       {
        "type": "box",
        "layout": "row",
        "children": [
         {
          "type": "input",
          "bind": "{market.query}",
          "placeholder": "What are you looking for?",
          "w": "fill",
          "h": 40,
          "focus": true
         },
         {
          "type": "button",
          "label": "{market.sortLabel}",
          "variant": "secondary",
          "icon": "ui_stall_sort",
          "w": 170,
          "h": 40
         },
         {
          "type": "button",
          "label": "Paid in",
          "variant": "secondary",
          "icon": "coin",
          "w": 130,
          "h": 40
         }
        ],
        "gap": 10,
        "h": 40,
        "align": "center",
        "w": "fill"
       },
       {
        "type": "list",
        "w": "fill",
        "h": "fill",
        "children": [
         {
          "type": "repeat",
          "each": "{market.results}",
          "as": "m",
          "layout": "col",
          "gap": 4,
          "w": "fill",
          "h": "auto",
          "template": {
           "type": "box",
           "layout": "row",
           "children": [
            {
             "type": "slot",
             "w": 48,
             "h": 48,
             "bind": "{m.item}",
             "showCount": false
            },
            {
             "type": "box",
             "layout": "col",
             "children": [
              {
               "type": "text",
               "text": "{m.item.name}",
               "font": "label",
               "h": 18
              },
              {
               "type": "box",
               "layout": "row",
               "children": [
                {
                 "type": "text",
                 "text": "{m.stallName} · {m.ownerName}",
                 "font": "tiny",
                 "w": "auto",
                 "color": "text.muted"
                },
                {
                 "type": "badge",
                 "text": "{\"[\" + m.clanTag + \"]\"}",
                 "color": "{m.clanColor}",
                 "w": 52,
                 "h": 18,
                 "visible": "{m.clanTag}"
                }
               ],
               "gap": 6,
               "h": 18,
               "align": "center",
               "w": "fill"
              }
             ],
             "w": "fill",
             "h": 40
            },
            {
             "type": "box",
             "layout": "row",
             "children": [
              {
               "type": "icon",
               "icon": "{m.priceIcon}",
               "w": 22,
               "h": 22
              },
              {
               "type": "text",
               "text": "{m.priceCount}",
               "font": "heading",
               "w": "auto"
              }
             ],
             "gap": 3,
             "w": 80,
             "h": 30,
             "align": "center"
            },
            {
             "type": "text",
             "text": "{m.stock} left",
             "font": "small",
             "w": 70
            },
            {
             "type": "text",
             "text": "{m.distance} m",
             "font": "small",
             "w": 56,
             "color": "text.muted"
            },
            {
             "type": "button",
             "label": "Pin",
             "variant": "info",
             "icon": "ic_pin",
             "w": 80,
             "h": 36,
             "action": {
              "event": "map.ping",
              "args": {
               "x": "{m.x}",
               "y": "{m.y}"
              }
             }
            }
           ],
           "gap": 10,
           "h": 56,
           "w": "fill",
           "align": "center",
           "pad": [
            4,
            8,
            4,
            8
           ],
           "focusable": true
          }
         }
        ]
       },
       {
        "type": "box",
        "layout": "row",
        "children": [
         {
          "type": "keyhint",
          "key": "A",
          "label": "Pin on map"
         },
         {
          "type": "keyhint",
          "key": "Y",
          "label": "Sort"
         },
         {
          "type": "keyhint",
          "key": "B",
          "label": "Close"
         }
        ],
        "gap": 14,
        "h": 30,
        "w": "auto",
        "align": "center"
       }
      ]
     }
    ]
   }
  ],
  "w": "fill",
  "h": "fill"
 }
}