{
  "name": "engine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "check": "pnpm -r typecheck && vitest run",
    "bench": "PERF=1 vitest run --no-file-parallelism packages/net/test/bench.test.ts packages/persist/test/bench.test.ts",
    "demo": "node scripts/demo.mjs",
    "demo:bots": "node scripts/demo.mjs --headless",
    "test:net": "vitest run packages/net packages/testkit apps/server apps/client"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vite": "^5.4.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0"
  }
}
