{
 "version": 1,
 "doc": "Cozy-Wild day/night grading keyframes. ambient = linear light multiplier (replaces render/timeOfDay.ts AMBIENT), sun = key-light colour (moon at night), shadowTint = colour projected/blob shadows and the cool split-tone go toward, fogTint = StyleConfig.fogColor, sky = clear colour. saturation/contrast/lift/gain map 1:1 to StyleConfig.grading. LUTs bake grading only (sat, contrast, split-tone, gain, lift) and are applied AFTER lighting/fog, so do not also apply StyleConfig.grading when a LUT is bound. Interpolate keyframes by hour with smoothstep, wrapping at 24h; blend the two neighbouring LUTs with the same weight.",
 "lutFormat": {
  "size": [
   256,
   16
  ],
  "cube": 16,
  "layout": "16 slices of 16x16; red along x within a slice, green along y (top row = green 0), blue = slice index (left = blue 0)",
  "colorSpace": "sRGB in / sRGB out (gamma-space, like the composite shader)",
  "identity": "lut/lut_identity.png"
 },
 "todRamp": {
  "image": "lut/tod_ramp_256x8.png",
  "x": "hour * 256 / 24",
  "rows": [
   "ambient / 1.25",
   "sun colour * intensity",
   "shadowTint",
   "fogTint",
   "sky",
   "lift * 4",
   "gain / 1.25",
   "R saturation/1.25, G contrast/1.25, B vignette"
  ]
 },
 "styleSuggestions": {
  "lightBands": 4,
  "bandMix": 0.55,
  "nightMinBrightness": 0.3,
  "nightTint": [
