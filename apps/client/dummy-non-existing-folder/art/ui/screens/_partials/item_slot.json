{
  "$schema": "../../screen.schema.json",
  "schema": "ui-partial/1",
  "params": {
    "slot": "slot",
    "size": 48,
    "hotkey": null
  },
  "root": {
    "type": "slot",
    "w": "{$size}",
    "h": "{$size}",
    "bind": "{$slot}",
    "hotkey": "{$hotkey}",
    "draggable": true,
    "foodStage": "{$slot.item.food.stage}",
    "tooltip": {
      "template": "_partials/item_tooltip.json",
      "params": {
        "item": "{$slot.item}"
      }
    },
    "action": {
      "event": "inventory.slotClick",
      "args": {
        "container": "{$slot.container}",
        "index": "{$slot.index}"
      }
    }
  }
}
