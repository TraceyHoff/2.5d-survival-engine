{
  "$schema": "../screen.schema.json",
  "schema": "ui-screen/1",
  "id": "stall_manage_perms",
  "title": "Clan stall rights",
  "layer": "window",
  "modal": false,
  "setsState": {
    "ui.windowOpen": true
  },
  "readOnly": true,
  "binds": "manage.perms[] {rank, label, acts[{act, on, reason}]} built from ECONOMY clan rank rules + StallActs",
  "root": {
    "type": "box",
    "layout": "abs",
    "children": [
      {
        "type": "scrim",
        "alpha": 0.3
      },
      {
        "type": "panel",
        "frame": "panel_wood_vine",
        "anchor": "cc",
        "w": 760,
        "h": 520,
        "pad": 22,
        "layout": "col",
        "gap": 8,
        "children": [
          {
            "type": "panel",
            "frame": "panel_parchment",
            "w": "fill",
            "h": "fill",
            "pad": 16,
            "layout": "col",
            "gap": 10,
            "children": [
              {
                "type": "box",
                "layout": "row",
                "children": [
                  {
                    "type": "icon",
                    "icon": "ui_stall_clan_key",
                    "w": 32,
                    "h": 32
                  },
                  {
                    "type": "text",
                    "text": "Clan stall rights \u00b7 [{stall.header.clanTag}] {stall.sign.name}",
                    "font": "heading",
                    "w": "fill"
                  }
                ],
                "gap": 8,
                "h": 36,
                "align": "center",
                "w": "fill"
              },
              {
                "type": "text",
                "text": "Who may do what at clan stalls. Set by the clan's ranks (economy config).",
                "font": "small",
                "w": "fill",
                "color": "text.secondary"
              },
              {
                "type": "box",
                "layout": "row",
                "children": [
                  {
                    "type": "text",
                    "text": "",
                    "font": "tiny",
                    "w": 156
                  },
                  {
                    "type": "text",
                    "text": "List",
                    "font": "label",
                    "w": 78,
                    "align": "center"
                  },
                  {
                    "type": "text",
                    "text": "Price",
                    "font": "label",
                    "w": 78,
                    "align": "center"
                  },
                  {
                    "type": "text",
                    "text": "Stock",
                    "font": "label",
                    "w": 78,
                    "align": "center"
                  },
                  {
                    "type": "text",
                    "text": "Collect",
                    "font": "label",
                    "w": 78,
                    "align": "center"
                  },
                  {
                    "type": "text",
                    "text": "Buy",
                    "font": "label",
                    "w": 78,
                    "align": "center"
                  }
                ],
                "gap": 10,
                "h": 22,
                "pad": [
                  0,
                  0,
                  0,
                  8
                ],
                "w": "fill"
              },
              {
                "type": "repeat",
                "each": "{manage.perms}",
                "as": "r",
                "layout": "col",
                "gap": 4,
                "w": "fill",
                "h": "auto",
                "template": {
                  "type": "box",
                  "layout": "row",
                  "children": [
                    {
                      "type": "rank",
                      "rank": "{r.rank}",
                      "w": 84,
                      "h": 26
                    },
                    {
                      "type": "box",
                      "layout": "row",
                      "children": [],
                      "w": 64
                    },
                    {
                      "type": "repeat",
                      "each": "{r.acts}",
                      "as": "a",
                      "layout": "row",
                      "gap": 10,
                      "w": "auto",
                      "h": 30,
                      "template": {
                        "type": "box",
                        "layout": "row",
                        "children": [
                          {
                            "type": "checkbox",
                            "bind": "{a.on}",
                            "w": 26,
                            "h": 26,
                            "disabled": true
                          },
                          {
                            "type": "icon",
                            "icon": "{a.on ? \"\" : \"ic_lock\"}",
                            "w": 16,
                            "h": 16
                          }
                        ],
                        "gap": 2,
                        "w": 78,
                        "h": 30,
                        "align": "center",
                        "tooltip": "{a.reason}"
                      }
                    }
                  ],
                  "gap": 8,
                  "h": 36,
                  "w": "fill",
                  "align": "center"
                }
              },
              {
                "type": "divider",
                "w": "fill",
                "h": 14
              },
              {
                "type": "box",
                "layout": "row",
                "children": [
                  {
                    "type": "icon",
                    "icon": "ic_info",
                    "w": 22,
                    "h": 22
                  },
                  {
                    "type": "text",
                    "text": "{manage.permNote}",
                    "font": "small",
                    "w": "fill",
                    "wrap": true
                  }
                ],
                "gap": 8,
                "h": 44,
                "align": "center",
                "w": "fill"
              },
              {
                "type": "box",
                "layout": "row",
                "children": [],
                "h": "fill",
                "w": "fill"
              },
              {
                "type": "box",
                "layout": "row",
                "children": [
                  {
                    "type": "keyhint",
                    "key": "LB RB",
                    "label": "Tabs"
                  },
                  {
                    "type": "keyhint",
                    "key": "B",
                    "label": "Close"
                  }
                ],
                "gap": 14,
                "h": 30,
                "w": "auto",
                "align": "center"
              }
            ]
          }
        ]
      }
    ],
    "w": "fill",
    "h": "fill"
  }
}
