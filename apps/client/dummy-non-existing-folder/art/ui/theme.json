  "steps": [
   1,
   1.5,
   2,
   3
  ],
  "rule": "uiScale = clamp(round_to_half(min(viewportW/1280, viewportH/720) * devicePixelRatio * userScale), 1, 3); use @2x atlas when uiScale*... > 1.25; integer-snap panel positions."
