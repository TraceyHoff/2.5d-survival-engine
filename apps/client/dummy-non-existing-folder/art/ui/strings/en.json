  "$reasonsDoc": "CommandRejected.reason from gameplay.setAppearance / equipCosmetic (DESIGN §10 + core validateAppearance). First matching pattern wins; {1},{2} = regex groups; {item} = wearable display name; {hint} = unlockHints[tag].",
  "reasons": [
    {
      "match": "^not_allowed$",
      "text": "Find a mirror to change your look! (Stand right next to one.)",
      "icon": "ic_info"
    },
    {
      "match": "^no_catalog$",
      "text": "The wardrobe is still unpacking... try again in a moment.",
      "icon": "ic_clock"
    },
    {
      "match": "^no_appearance$",
      "text": "Make your camper first!",
      "icon": "ic_person"
    },
    {
      "match": "^bad_slot$",
      "text": "Hmm, that slot doesn't exist.",
      "icon": "ic_warn"
    },
    {
      "match": "^(\\w+): wearable (\\w+) is locked$",
      "text": "{item} is still locked. {hint}",
      "icon": "ic_lock"
    },
    {
      "match": "^(\\w+): unknown wearable",
      "text": "That item wandered off. It isn't in the wardrobe any more.",
      "icon": "ic_warn"
    },
    {
      "match": "^(\\w+): wearable (\\w+) belongs to (\\w+)$",
      "text": "{item} doesn't go there, silly!",
      "icon": "ic_warn"
    },
    {
      "match": "^(\\w+): wearable (\\w+) has no (\\w+) art$",
      "text": "{item} doesn't come in that fit yet.",
      "icon": "ic_warn"
    },
    {
      "match": "^(\\w+): bad (primary|secondary) color",
      "text": "That colour isn't on the palette.",
      "icon": "ic_warn"
    },
    {
      "match": "^bad skinTone",
      "text": "Pick a skin tone from the swatches.",
      "icon": "ic_warn"
    },
    {
      "match": "^bad bodyType",
      "text": "Pick a body type first.",
      "icon": "ic_warn"
    },
    {
      "match": ".*",
      "text": "Couldn't change your look right now ({reason}).",
      "icon": "ic_warn"
    }
  ],
  "stall.badge.open": "Open",
  "stall.badge.soldout": "Sold out",
  "stall.badge.closed": "Closed",
  "stall.badge.clan": "Clan"
}