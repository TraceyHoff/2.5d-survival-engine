{
 "_doc": "VirtualLayout per variant/context. Pick variant: tablet if min(cssW,cssH) >= 600dp else phone; portrait if h > w. Anchors are normalized inside the safe area (env(safe-area-inset-*) -> --sat/--sar/--sab/--sal). radius in dp at reference; engine scale = clamp(min(w/refW, h/refH), 0.75, 2). Mirror x for left-handed (settings.input.leftHanded).",
 "minHitDp": 48,
 "safeArea": {
  "cssVars": [
   "--sat",
   "--sar",
   "--sab",
   "--sal"
  ],
  "minInsetDp": {
   "top": 8,
   "right": 12,
   "bottom": 10,
   "left": 12
  },
  "note": "add minInsetDp on top of the device insets so thumbs never land on the home indicator / rounded corners"
 },
 "variantRule": {
  "tabletMinShortSideDp": 600,
  "portraitIf": "h > w"
 },
 "opacity": {
  "idle": 0.72,
  "pressed": 1.0,
  "disabled": 0.4,
  "fadeAfterIdleMs": 6000,
  "fadedOpacity": 0.38
 },
