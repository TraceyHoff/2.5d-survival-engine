    "action": "Build.LevelUp",
    "control": "touch.btn.levelup"
   },
   {
    "action": "Build.LevelDown",
    "control": "touch.btn.leveldown"
   },
   {
    "action": "Build.DemolishMode",
    "control": "touch.btn.demolish"
   },
   {
    "action": "Build.UpgradeMode",
    "control": "touch.btn.upgrade"
   },
   {
    "action": "Build.RepairMode",
    "control": "touch.btn.repair"
   },
   {
    "action": "Build.Nudge",
    "composite": {
     "x": "touch.ghost.x",
     "y": "touch.ghost.y"
    }
   },
   {
    "action": "ToggleBuild",
    "control": "touch.btn.build"
   }
