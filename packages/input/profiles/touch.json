{
 "id": "default.touch",
 "deviceClass": "touch",
 "bindings": {
  "Gameplay": [
   {
    "action": "Move",
    "composite": {
     "x": "touch.move.x",
     "y": "touch.move.y"
    }
   },
   {
    "action": "Aim",
    "composite": {
     "x": "touch.aim.x",
     "y": "touch.aim.y"
    }
   },
   {
    "action": "Sprint",
    "control": "touch.btn.sprint",
    "interaction": {
     "type": "toggle"
    }
   },
   {
    "action": "Primary",
    "control": "touch.btn.attack"
   },
   {
    "action": "Charge",
    "control": "touch.btn.attack",
    "interaction": {
     "type": "hold",
     "ms": 350
    }
   },
   {
    "action": "Secondary",
    "control": "touch.btn.secondary"
   },
   {
    "action": "Crouch",
    "control": "touch.btn.crouch"
   },
