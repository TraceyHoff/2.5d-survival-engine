    "action": "Cancel",
    "control": "touch.btn.back"
   },
   {
    "action": "ToggleBuild",
    "control": "touch.btn.build"
   },
   {
    "action": "Camera.Zoom",
    "composite": {
     "negative": "touch.pinch.in",
     "positive": "touch.pinch.out"
    }
   },
   {
    "action": "Vehicle.Engine",
    "control": "touch.btn.engine"
   },
