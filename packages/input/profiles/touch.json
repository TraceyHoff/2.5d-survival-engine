  "Inventory": [
   {
    "action": "Inv.MoveSlot",
    "control": "touch.tap"
   },
   {
    "action": "Inv.QuickTransfer",
    "control": "touch.doubleTap"
   },
   {
    "action": "Inv.SplitStack",
