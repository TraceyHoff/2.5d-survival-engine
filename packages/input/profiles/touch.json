   {
    "action": "Interact",
    "control": "touch.btn.context",
    "interaction": {
     "type": "tap",
     "maxMs": 400
    }
   },
   {
    "action": "ContextRadial",
    "control": "touch.btn.context",
    "interaction": {
     "type": "longPress",
     "ms": 500
    }
   },
   {
    "action": "Jump",
    "control": "touch.btn.jump"
   },
   {
    "action": "Reload",
    "control": "touch.btn.reload"
