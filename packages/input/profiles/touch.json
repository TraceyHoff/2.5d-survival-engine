    "action": "ToggleCrafting",
    "control": "touch.btn.crafting"
   },
   {
    "action": "ToggleMap",
    "control": "touch.btn.map"
   },
   {
    "action": "OpenChat",
    "control": "touch.btn.chat"
   },
   {
    "action": "OpenSocial",
    "control": "touch.btn.social"
   },
