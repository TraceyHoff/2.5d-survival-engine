   {
    "action": "Social.Invite",
    "control": "touch.btn.invite"
   },
   {
    "action": "Social.Kick",
    "control": "touch.btn.kick"
   },
   {
    "action": "Social.Promote",
    "control": "touch.btn.promote"
   },
   {
    "action": "Social.Demote",
    "control": "touch.btn.demote"
   },
   {
    "action": "Social.Leave",
    "control": "touch.btn.leave",
    "interaction": {
     "type": "longPress",
     "ms": 800
    }
   },
   {
    "action": "Social.SetPermissions",
    "control": "touch.btn.perms"
   },
   {
    "action": "UI.Back",
    "control": "touch.btn.back"
   }
  ],
  "Dialog": [
   {
    "action": "Dialog.Confirm",
    "control": "touch.btn.yes"
   },
   {
    "action": "Dialog.Cancel",
    "control": "touch.btn.no"
   }
  ],
  "Road": [
   {
    "action": "Road.Confirm",
    "control": "touch.btn.confirm"
   },
   {
    "action": "Road.Cancel",
    "control": "touch.btn.cancel"
   }
  ]
 }
}
