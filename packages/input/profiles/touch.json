    "interaction": {
     "type": "repeat",
     "delayMs": 400,
     "rateMs": 120
    }
   },
   {
    "action": "Craft.Cancel",
    "control": "touch.btn.cancelcraft"
   },
   {
    "action": "Craft.FilterNext",
    "control": "touch.swipe.left"
   },
   {
    "action": "Craft.FilterPrev",
    "control": "touch.swipe.right"
   },
   {
    "action": "UI.Back",
    "control": "touch.btn.back"
   }
  ],
  "Trade": [
   {
    "action": "Trade.AddOffer",
    "control": "touch.tap"
   },
   {
    "action": "Trade.RemoveOffer",
    "control": "touch.longPress"
   },
   {
    "action": "Trade.Lock",
    "control": "touch.btn.lock"
   },
   {
    "action": "Trade.Confirm",
    "control": "touch.btn.confirm"
   },
   {
    "action": "UI.Back",
    "control": "touch.btn.back"
   }
