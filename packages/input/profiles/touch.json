    "control": "touch.btn.drop"
   },
   {
    "action": "Inv.Equip",
    "control": "touch.btn.equip"
   },
   {
    "action": "Inv.Use",
    "control": "touch.btn.use"
   },
   {
    "action": "Inv.TakeAll",
    "control": "touch.btn.takeall"
   },
   {
    "action": "Inv.Sort",
    "control": "touch.btn.sort"
